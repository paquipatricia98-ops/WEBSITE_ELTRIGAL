---
import { SITE_CONFIG } from '../../config/site';
import { useTranslations } from '../../i18n/utils';
import type { Locale } from '../../types/api';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<div class="bg-brand-cream p-6 sm:p-8 rounded-3xl border-2 border-brand-gold/30 shadow-xl">
  <h2 class="font-serif text-2xl sm:text-3xl font-bold text-brand-brown mb-6">
    {t('form.contactTitle')}
  </h2>

  <!-- Global Form Alert Banner -->
  <div id="contact-alert" class="hidden mb-6 p-4 rounded-xl text-sm font-semibold" role="alert"></div>

  <form id="contact-form" class="space-y-5" novalidate>
    <input type="hidden" name="locale" value={locale} />
    
    <!-- Honeypot -->
    <div class="hidden" aria-hidden="true">
      <label for="contact-website">Leave this field blank</label>
      <input type="text" id="contact-website" name="website" tabindex="-1" autocomplete="off" />
    </div>

    <!-- Name -->
    <div>
      <label for="contact-name" class="block text-sm font-bold text-brand-brown mb-1">
        {t('form.nameLabel')}
      </label>
      <input
        type="text"
        id="contact-name"
        name="name"
        required
        minlength="2"
        maxlength="80"
        class="w-full px-4 py-3 rounded-xl border border-brand-brown/20 bg-brand-cream-dark/50 text-brand-brown focus:ring-2 focus:ring-brand-gold focus:border-brand-gold focus:outline-none transition-all text-base"
        placeholder="Ej: María Cárdenas"
      />
      <span id="error-name" class="text-xs text-red-600 font-semibold mt-1 block hidden"></span>
    </div>

    <!-- Email -->
    <div>
      <label for="contact-email" class="block text-sm font-bold text-brand-brown mb-1">
        {t('form.emailLabel')}
      </label>
      <input
        type="email"
        id="contact-email"
        name="email"
        required
        maxlength="254"
        class="w-full px-4 py-3 rounded-xl border border-brand-brown/20 bg-brand-cream-dark/50 text-brand-brown focus:ring-2 focus:ring-brand-gold focus:border-brand-gold focus:outline-none transition-all text-base"
        placeholder={SITE_CONFIG.email}
      />
      <span id="error-email" class="text-xs text-red-600 font-semibold mt-1 block hidden"></span>
    </div>

    <!-- Phone -->
    <div>
      <label for="contact-phone" class="block text-sm font-bold text-brand-brown mb-1">
        {t('form.phoneLabel')}
      </label>
      <input
        type="tel"
        id="contact-phone"
        name="phone"
        inputmode="tel"
        class="w-full px-4 py-3 rounded-xl border border-brand-brown/20 bg-brand-cream-dark/50 text-brand-brown focus:ring-2 focus:ring-brand-gold focus:border-brand-gold focus:outline-none transition-all text-base"
        placeholder={SITE_CONFIG.phone.businessDisplay}
      />
      <span id="error-phone" class="text-xs text-red-600 font-semibold mt-1 block hidden"></span>
    </div>

    <!-- Subject -->
    <div>
      <label for="contact-subject" class="block text-sm font-bold text-brand-brown mb-1">
        {t('form.subjectLabel')}
      </label>
      <input
        type="text"
        id="contact-subject"
        name="subject"
        required
        minlength="3"
        maxlength="100"
        class="w-full px-4 py-3 rounded-xl border border-brand-brown/20 bg-brand-cream-dark/50 text-brand-brown focus:ring-2 focus:ring-brand-gold focus:border-brand-gold focus:outline-none transition-all text-base"
        placeholder="Consulta sobre pedidos especiales"
      />
      <span id="error-subject" class="text-xs text-red-600 font-semibold mt-1 block hidden"></span>
    </div>

    <!-- Message -->
    <div>
      <label for="contact-message" class="block text-sm font-bold text-brand-brown mb-1">
        {t('form.messageLabel')}
      </label>
      <textarea
        id="contact-message"
        name="message"
        rows="4"
        required
        minlength="10"
        maxlength="2000"
        class="w-full px-4 py-3 rounded-xl border border-brand-brown/20 bg-brand-cream-dark/50 text-brand-brown focus:ring-2 focus:ring-brand-gold focus:border-brand-gold focus:outline-none transition-all text-base"
        placeholder="Escribe tu mensaje aquí..."
      ></textarea>
      <span id="error-message" class="text-xs text-red-600 font-semibold mt-1 block hidden"></span>
    </div>

    <!-- Submit Button -->
    <!-- Honeypot -->
    <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off">
    
    <button
      type="submit"
      id="contact-submit"
      class="w-full py-4 rounded-xl bg-brand-brown text-brand-gold font-bold text-base hover:bg-brand-brown-dark border-2 border-brand-gold shadow-lg transition-all flex items-center justify-center space-x-2"
    >
      <span>{t('form.send')}</span>
    </button>

  </form>

  <!-- Success Modal (Tailwind styled like Bootstrap) -->
  <div id="contact-success-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50 transition-opacity">
    <div class="bg-white rounded-lg shadow-xl w-11/12 max-w-md mx-auto overflow-hidden transform transition-all scale-95 opacity-0" id="contact-success-modal-content">
      <div class="border-b px-4 py-3 flex justify-between items-center">
        <h5 class="text-lg font-semibold text-gray-800 m-0">¡Enviado exitosamente!</h5>
        <button type="button" id="close-contact-modal-x" class="text-gray-400 hover:text-gray-600 focus:outline-none">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
      </div>
      <div class="p-4 text-gray-600 text-sm">
        <p>Tu mensaje ha sido enviado correctamente.</p>
        <p class="mt-2">Te responderemos a la brevedad posible.</p>
        <p class="text-xs mt-3 pt-3 border-t text-gray-500">Nota para administrador: La primera vez, <b>Lizbeth debe abrir su correo</b> y dar clic en "Activar" el servicio de FormSubmit.</p>
      </div>
      <div class="border-t px-4 py-3 flex justify-end bg-gray-50">
        <button type="button" id="close-contact-modal-btn" class="bg-[#0d6efd] hover:bg-[#0b5ed7] text-white px-4 py-2 rounded font-medium transition-colors">
          Aceptar
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  import { submitContact } from '../../services/api/publicApi';
  import { ContactFormSchema } from '../../schemas/forms';

  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const alert = document.getElementById('contact-alert');
  const submitBtn = document.getElementById('contact-submit') as HTMLButtonElement | null;

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      // Clear errors
      document.querySelectorAll('[id^="error-"]').forEach((el) => {
        el.classList.add('hidden');
        el.textContent = '';
      });
      if (alert) {
        alert.classList.add('hidden');
        alert.className = 'hidden mb-6 p-4 rounded-xl text-sm font-semibold';
      }

      const formData = new FormData(form);
      if (formData.get('_honey')) return;
      const rawData = {
        name: formData.get('name')?.toString() || '',
        email: formData.get('email')?.toString() || '',
        phone: formData.get('phone')?.toString() || undefined,
        subject: formData.get('subject')?.toString() || '',
        message: formData.get('message')?.toString() || '',
        locale: formData.get('locale')?.toString() || 'es',
        website: formData.get('website')?.toString() || undefined,
      };

      const parsed = ContactFormSchema.safeParse(rawData);

      if (!parsed.success) {
        parsed.error.errors.forEach((err) => {
          const fieldName = err.path[0];
          const errEl = document.getElementById(`error-${fieldName}`);
          if (errEl) {
            errEl.textContent = err.message;
            errEl.classList.remove('hidden');
          }
        });
        if (alert) {
          alert.textContent = 'Por favor corrige los errores resaltados en el formulario.';
          alert.classList.remove('hidden');
          alert.classList.add('bg-red-100', 'text-red-800', 'border', 'border-red-300');
        }
        return;
      }

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Enviando...';
      }

      try {
        const res = await submitContact(parsed.data);
        
        // Send email notification to lizbeth.toroshina@gmail.com via FormSubmit
        try {
          await fetch("https://formsubmit.co/ajax/lizbeth.toroshina@gmail.com", {
            method: "POST",
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json'
            },
            body: JSON.stringify({
              _subject: "Nuevo Mensaje de Contacto - El Trigal",
              Nombre: parsed.data.name,
              Email: parsed.data.email,
              Telefono: parsed.data.phone || "No proporcionado",
              Asunto: parsed.data.subject,
              Mensaje: parsed.data.message,
              _template: "table"
            })
          });
        } catch (emailErr) {
          console.warn("No se pudo enviar el correo de notificación:", emailErr);
        }

        if (res.success) {
          // Show Bootstrap-style Modal
          const modal = document.getElementById('contact-success-modal');
          const modalContent = document.getElementById('contact-success-modal-content');
          if (modal && modalContent) {
            modal.classList.remove('hidden');
            // Trigger animation
            setTimeout(() => {
              modalContent.classList.remove('scale-95', 'opacity-0');
              modalContent.classList.add('scale-100', 'opacity-100');
            }, 10);
          }
          
          form.reset();
        } else {
          throw new Error(res.error.message);
        }
      } catch {
        if (alert) {
          alert.textContent = 'Ocurrió un error al enviar tu mensaje. Por favor llámanos directamente.';
          alert.classList.remove('hidden');
          alert.classList.add('bg-red-100', 'text-red-800', 'border', 'border-red-300');
        }
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Enviar Mensaje';
        }
      }
    });

    // Modal Close Logic
    const closeContactModal = () => {
      const modal = document.getElementById('contact-success-modal');
      const modalContent = document.getElementById('contact-success-modal-content');
      if (modal && modalContent) {
        modalContent.classList.remove('scale-100', 'opacity-100');
        modalContent.classList.add('scale-95', 'opacity-0');
        setTimeout(() => {
          modal.classList.add('hidden');
        }, 200);
      }
    };

    document.getElementById('close-contact-modal-x')?.addEventListener('click', closeContactModal);
    document.getElementById('close-contact-modal-btn')?.addEventListener('click', closeContactModal);
  }
</script>
