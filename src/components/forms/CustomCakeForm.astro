---
import { useTranslations } from '../../i18n/utils';
import type { Locale } from '../../types/api';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const today = new Date().toISOString().split('T')[0];
const maxDate = new Date();
maxDate.setDate(maxDate.getDate() + 730);
const maxDateStr = maxDate.toISOString().split('T')[0];
---

<div id="cotizar" class="bg-brand-cream p-6 sm:p-10 rounded-3xl border-2 border-brand-gold/30 shadow-2xl">
  <div class="mb-8 text-center sm:text-left space-y-2">
    <span class="text-xs uppercase tracking-widest font-bold text-brand-gold-secondary">
      🎂 {locale === 'es' ? 'Cotización en Línea' : 'Online Quote'}
    </span>
    <h2 class="font-serif text-3xl font-bold text-brand-brown">
      {t('cakeForm.title')}
    </h2>
    <p class="text-xs sm:text-sm text-brand-brown/80">
      {locale === 'es'
        ? 'Completa los detalles de tu evento y te contactaremos en menos de 24 horas con la cotización exacta.'
        : 'Fill in your event details and we will get back to you within 24 hours with an exact quote.'}
    </p>
  </div>

  <!-- Global Alert Banner -->
  <div id="cake-alert" class="hidden mb-6 p-4 rounded-xl text-sm font-semibold" role="alert"></div>

  <form id="cake-form" class="space-y-6" novalidate>
    <input type="hidden" name="locale" value={locale} />
    
    <!-- Honeypot -->
    <div class="hidden" aria-hidden="true">
      <label for="cake-website">Leave this field blank</label>
      <input type="text" id="cake-website" name="website" tabindex="-1" autocomplete="off" />
    </div>

    <!-- Contact Info Section -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
      <div>
        <label for="cake-customerName" class="block text-sm font-bold text-brand-brown mb-1">
          {t('cakeForm.customerName')}
        </label>
        <input
          type="text"
          id="cake-customerName"
          name="customerName"
          required
          minlength="2"
          maxlength="80"
          class="w-full px-4 py-3 rounded-xl border border-brand-brown/20 bg-brand-cream-dark/50 text-brand-brown focus:ring-2 focus:ring-brand-gold focus:border-brand-gold focus:outline-none transition-all text-base"
          placeholder="Ej: Carlos Villacís"
        />
        <span id="cake-error-customerName" class="text-xs text-red-600 font-semibold mt-1 block hidden"></span>
      </div>

      <div>
        <label for="cake-email" class="block text-sm font-bold text-brand-brown mb-1">
          {t('cakeForm.email')}
        </label>
        <input
          type="email"
          id="cake-email"
          name="email"
          required
          class="w-full px-4 py-3 rounded-xl border border-brand-brown/20 bg-brand-cream-dark/50 text-brand-brown focus:ring-2 focus:ring-brand-gold focus:border-brand-gold focus:outline-none transition-all text-base"
          placeholder="ejemplo@correo.com"
        />
        <span id="cake-error-email" class="text-xs text-red-600 font-semibold mt-1 block hidden"></span>
      </div>
    </div>

    <!-- Phone & Event Date -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
      <div>
        <label for="cake-phone" class="block text-sm font-bold text-brand-brown mb-1">
          {t('cakeForm.phone')}
        </label>
        <input
          type="tel"
          id="cake-phone"
          name="phone"
          required
          inputmode="tel"
          class="w-full px-4 py-3 rounded-xl border border-brand-brown/20 bg-brand-cream-dark/50 text-brand-brown focus:ring-2 focus:ring-brand-gold focus:border-brand-gold focus:outline-none transition-all text-base"
          placeholder="(347) 842-9351"
        />
        <span id="cake-error-phone" class="text-xs text-red-600 font-semibold mt-1 block hidden"></span>
      </div>

      <div>
        <label for="cake-eventDate" class="block text-sm font-bold text-brand-brown mb-1">
          {t('cakeForm.eventDate')}
        </label>
        <input
          type="date"
          id="cake-eventDate"
          name="eventDate"
          required
          min={today}
          max={maxDateStr}
          class="w-full px-4 py-3 rounded-xl border border-brand-brown/20 bg-brand-cream-dark/50 text-brand-brown focus:ring-2 focus:ring-brand-gold focus:border-brand-gold focus:outline-none transition-all text-base"
        />
        <span id="cake-error-eventDate" class="text-xs text-red-600 font-semibold mt-1 block hidden"></span>
      </div>
    </div>

    <!-- Event Type & Servings -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
      <div>
        <label for="cake-eventType" class="block text-sm font-bold text-brand-brown mb-1">
          {t('cakeForm.eventType')}
        </label>
        <select
          id="cake-eventType"
          name="eventType"
          required
          class="w-full px-4 py-3 rounded-xl border border-brand-brown/20 bg-brand-cream-dark/50 text-brand-brown focus:ring-2 focus:ring-brand-gold focus:border-brand-gold focus:outline-none transition-all text-base"
        >
          <option value="birthday">{t('eventType.birthday')}</option>
          <option value="baptism">{t('eventType.baptism')}</option>
          <option value="communion">{t('eventType.communion')}</option>
          <option value="confirmation">{t('eventType.confirmation')}</option>
          <option value="wedding">{t('eventType.wedding')}</option>
          <option value="graduation">{t('eventType.graduation')}</option>
          <option value="corporate">{t('eventType.corporate')}</option>
          <option value="other">{t('eventType.other')}</option>
        </select>
        <span id="cake-error-eventType" class="text-xs text-red-600 font-semibold mt-1 block hidden"></span>
      </div>

      <div>
        <label for="cake-servings" class="block text-sm font-bold text-brand-brown mb-1">
          {t('cakeForm.servings')}
        </label>
        <input
          type="number"
          id="cake-servings"
          name="servings"
          required
          min="1"
          max="500"
          step="1"
          inputmode="numeric"
          class="w-full px-4 py-3 rounded-xl border border-brand-brown/20 bg-brand-cream-dark/50 text-brand-brown focus:ring-2 focus:ring-brand-gold focus:border-brand-gold focus:outline-none transition-all text-base"
          placeholder="Ej: 25"
        />
        <span id="cake-error-servings" class="text-xs text-red-600 font-semibold mt-1 block hidden"></span>
      </div>
    </div>

    <!-- Flavor & Filling -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
      <div>
        <label for="cake-flavor" class="block text-sm font-bold text-brand-brown mb-1">
          {t('cakeForm.flavor')}
        </label>
        <input
          type="text"
          id="cake-flavor"
          name="flavor"
          maxlength="80"
          class="w-full px-4 py-3 rounded-xl border border-brand-brown/20 bg-brand-cream-dark/50 text-brand-brown focus:ring-2 focus:ring-brand-gold focus:border-brand-gold focus:outline-none transition-all text-base"
          placeholder="Ej: Tres Leches, Vainilla, Chocolate"
        />
        <span id="cake-error-flavor" class="text-xs text-red-600 font-semibold mt-1 block hidden"></span>
      </div>

      <div>
        <label for="cake-filling" class="block text-sm font-bold text-brand-brown mb-1">
          {t('cakeForm.filling')}
        </label>
        <input
          type="text"
          id="cake-filling"
          name="filling"
          maxlength="80"
          class="w-full px-4 py-3 rounded-xl border border-brand-brown/20 bg-brand-cream-dark/50 text-brand-brown focus:ring-2 focus:ring-brand-gold focus:border-brand-gold focus:outline-none transition-all text-base"
          placeholder="Ej: Manjar, Frutos rojos, Maracuyá"
        />
        <span id="cake-error-filling" class="text-xs text-red-600 font-semibold mt-1 block hidden"></span>
      </div>
    </div>

    <!-- Theme & Details -->
    <div>
      <label for="cake-theme" class="block text-sm font-bold text-brand-brown mb-1">
        {t('cakeForm.theme')}
      </label>
      <input
        type="text"
        id="cake-theme"
        name="theme"
        maxlength="120"
        class="w-full px-4 py-3 rounded-xl border border-brand-brown/20 bg-brand-cream-dark/50 text-brand-brown focus:ring-2 focus:ring-brand-gold focus:border-brand-gold focus:outline-none transition-all text-base"
        placeholder="Ej: Temática flores doradas, bautizo blanco y oro"
      />
      <span id="cake-error-theme" class="text-xs text-red-600 font-semibold mt-1 block hidden"></span>
    </div>

    <div>
      <label for="cake-message" class="block text-sm font-bold text-brand-brown mb-1">
        {t('cakeForm.message')}
      </label>
      <textarea
        id="cake-message"
        name="message"
        rows="3"
        maxlength="2000"
        class="w-full px-4 py-3 rounded-xl border border-brand-brown/20 bg-brand-cream-dark/50 text-brand-brown focus:ring-2 focus:ring-brand-gold focus:border-brand-gold focus:outline-none transition-all text-base"
        placeholder="Especificaciones adicionales de diseño, pisos, alérgenos..."
      ></textarea>
      <span id="cake-error-message" class="text-xs text-red-600 font-semibold mt-1 block hidden"></span>
    </div>

    <!-- Consent Checkbox -->
    <div class="flex items-start space-x-3 pt-2">
      <input
        type="checkbox"
        id="cake-consent"
        name="consent"
        required
        class="mt-1 w-5 h-5 text-brand-gold border-brand-brown/30 rounded focus:ring-brand-gold"
      />
      <label for="cake-consent" class="text-xs sm:text-sm text-brand-brown font-semibold leading-snug cursor-pointer">
        {t('cakeForm.consent')}
      </label>
    </div>
    <span id="cake-error-consent" class="text-xs text-red-600 font-semibold mt-1 block hidden"></span>

    <!-- Honeypot -->
    <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off">

    <!-- Submit Buttons -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <button
        type="submit"
        id="cake-submit"
        class="w-full py-4 rounded-xl bg-brand-gold text-brand-brown font-bold text-base hover:bg-brand-gold-secondary shadow-lg transition-all flex items-center justify-center space-x-2"
      >
        <span>{t('cakeForm.submit')}</span>
      </button>

      <a
        href="https://wa.me/13478429351?text=Hola%2C%20quisiera%20cotizar%20un%20pastel%20personalizado."
        target="_blank"
        rel="noopener noreferrer"
        class="relative w-full py-4 rounded-xl bg-[#25D366] text-white font-bold text-base shadow-lg hover:shadow-xl transition-all flex items-center justify-center space-x-2 overflow-hidden group"
      >
        <!-- Constant thin clear border around the perimeter -->
        <span class="absolute inset-0 rounded-xl border border-white/40 z-20 pointer-events-none"></span>
        
        <!-- Rotating sharp light beam effect -->
        <span class="absolute w-[250%] h-[250%] bg-[conic-gradient(from_0deg,transparent_0_270deg,rgba(255,255,255,1)_360deg)] animate-[spin_2s_linear_infinite] opacity-100 z-0"></span>
        
        <!-- Inner background to mask the center, leaving exactly 1px for the spinning line -->
        <span class="absolute inset-[1px] bg-[#25D366] rounded-[11px] group-hover:bg-[#128C7E] transition-colors z-10"></span>
        
        <!-- Button content -->
        <div class="relative z-30 flex items-center space-x-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>
          </svg>
          <span>{locale === 'es' ? 'Cotizar por WhatsApp' : 'Quote via WhatsApp'}</span>
        </div>
      </a>
    </div>

  </form>

  <!-- Success Modal (Tailwind styled like Bootstrap) -->
  <div id="success-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50 transition-opacity">
    <div class="bg-white rounded-lg shadow-xl w-11/12 max-w-md mx-auto overflow-hidden transform transition-all scale-95 opacity-0" id="success-modal-content">
      <div class="border-b px-4 py-3 flex justify-between items-center">
        <h5 class="text-lg font-semibold text-gray-800 m-0">¡Enviado exitosamente!</h5>
        <button type="button" id="close-modal-x" class="text-gray-400 hover:text-gray-600 focus:outline-none">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
      </div>
      <div class="p-4 text-gray-600 text-sm">
        <p>Tu solicitud de cotización ha sido enviada correctamente.</p>
        <p class="mt-2">Nuestro maestro pastelero la revisará y te contactaremos en menos de 24 horas.</p>
        <p class="text-xs mt-3 pt-3 border-t text-gray-500">Nota para administrador: La primera vez, <b>Lizbeth debe abrir su correo</b> y dar clic en "Activar" el servicio de FormSubmit.</p>
      </div>
      <div class="border-t px-4 py-3 flex justify-end bg-gray-50">
        <button type="button" id="close-modal-btn" class="bg-[#0d6efd] hover:bg-[#0b5ed7] text-white px-4 py-2 rounded font-medium transition-colors">
          Aceptar
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  import { submitCustomCakeRequest } from '../../services/api/publicApi';
  import { CustomCakeFormSchema } from '../../schemas/forms';

  const form = document.getElementById('cake-form') as HTMLFormElement | null;
  const alert = document.getElementById('cake-alert');
  const submitBtn = document.getElementById('cake-submit') as HTMLButtonElement | null;

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      // Clear errors
      document.querySelectorAll('[id^="cake-error-"]').forEach((el) => {
        el.classList.add('hidden');
        el.textContent = '';
      });
      if (alert) {
        alert.classList.add('hidden');
        alert.className = 'hidden mb-6 p-4 rounded-xl text-sm font-semibold';
      }

      const formData = new FormData(form);
      if (formData.get('_honey')) return;
      const rawData = {
        customerName: formData.get('customerName')?.toString() || '',
        email: formData.get('email')?.toString() || '',
        phone: formData.get('phone')?.toString() || '',
        eventDate: formData.get('eventDate')?.toString() || '',
        eventType: formData.get('eventType')?.toString() || 'birthday',
        servings: formData.get('servings') ? Number(formData.get('servings')) : NaN,
        flavor: formData.get('flavor')?.toString() || undefined,
        filling: formData.get('filling')?.toString() || undefined,
        theme: formData.get('theme')?.toString() || undefined,
        message: formData.get('message')?.toString() || undefined,
        consent: formData.get('consent') === 'on' ? true : false,
        locale: formData.get('locale')?.toString() || 'es',
        website: formData.get('website')?.toString() || undefined,
      };

      const parsed = CustomCakeFormSchema.safeParse(rawData);

      if (!parsed.success) {
        parsed.error.errors.forEach((err) => {
          const fieldName = err.path[0];
          const errEl = document.getElementById(`cake-error-${fieldName}`);
          if (errEl) {
            errEl.textContent = err.message;
            errEl.classList.remove('hidden');
          }
        });
        if (alert) {
          alert.textContent = 'Por favor verifica los datos ingresados en el formulario.';
          alert.classList.remove('hidden');
          alert.classList.add('bg-red-100', 'text-red-800', 'border', 'border-red-300');
        }
        return;
      }

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Enviando solicitud...';
      }

      try {
        const res = await submitCustomCakeRequest(parsed.data);
        
        // Send email notification to lizbeth.toroshina@gmail.com via FormSubmit
        try {
          await fetch("https://formsubmit.co/ajax/lizbeth.toroshina@gmail.com", {
            method: "POST",
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json'
            },
            body: JSON.stringify({
              _subject: "Nueva Cotización de Pastel Personalizado",
              Nombre: parsed.data.customerName,
              Email: parsed.data.email,
              Telefono: parsed.data.phone,
              FechaEvento: parsed.data.eventDate,
              TipoEvento: parsed.data.eventType,
              Porciones: parsed.data.servings,
              Sabor: parsed.data.flavor || "No especificado",
              Relleno: parsed.data.filling || "No especificado",
              Tematica: parsed.data.theme || "No especificado",
              Mensaje: parsed.data.message || "Sin mensaje adicional",
              _template: "table"
            })
          });
        } catch (emailErr) {
          console.warn("No se pudo enviar el correo de notificación:", emailErr);
        }

        if (res.success) {
          // Show Bootstrap-style Modal
          const modal = document.getElementById('success-modal');
          const modalContent = document.getElementById('success-modal-content');
          if (modal && modalContent) {
            modal.classList.remove('hidden');
            // Trigger animation
            setTimeout(() => {
              modalContent.classList.remove('scale-95', 'opacity-0');
              modalContent.classList.add('scale-100', 'opacity-100');
            }, 10);
          }
          
          form.reset();
        } else {
          throw new Error(res.error.message);
        }
      } catch {
        if (alert) {
          alert.textContent = 'No se pudo enviar la solicitud. Por favor llámanos directamente al (347) 842-9351.';
          alert.classList.remove('hidden');
          alert.classList.add('bg-red-100', 'text-red-800', 'border', 'border-red-300');
        }
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Enviar Solicitud de Cotización';
        }
      }
    });
    
    // Modal Close Logic
    const closeModal = () => {
      const modal = document.getElementById('success-modal');
      const modalContent = document.getElementById('success-modal-content');
      if (modal && modalContent) {
        modalContent.classList.remove('scale-100', 'opacity-100');
        modalContent.classList.add('scale-95', 'opacity-0');
        setTimeout(() => {
          modal.classList.add('hidden');
        }, 200);
      }
    };

    document.getElementById('close-modal-x')?.addEventListener('click', closeModal);
    document.getElementById('close-modal-btn')?.addEventListener('click', closeModal);
  }
</script>
