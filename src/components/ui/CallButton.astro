---
import { SITE_CONFIG } from '../../config/site';

import type { Locale } from '../../types/api';

interface Props {
  locale: Locale;
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}

const { locale, size = 'md', class: className = '' } = Astro.props;


const sizeClasses = {
  sm: 'px-3 py-1.5 text-xs',
  md: 'px-4 py-2 text-sm',
  lg: 'px-6 py-3 text-base',
};

const iconSizes = {
  sm: 'w-3.5 h-3.5',
  md: 'w-4 h-4',
  lg: 'w-5 h-5',
};
---

<a
  href={SITE_CONFIG.phone.businessTel}
  class={`inline-flex items-center justify-center gap-1.5 font-bold rounded-lg transition-all duration-300 shadow-sm hover:shadow-md hover:-translate-y-0.5 active:scale-95 bg-brand-brown text-brand-gold hover:bg-brand-brown-dark border border-brand-gold/30 ${sizeClasses[size]} ${className}`}
  aria-label="Llamar a Panadería El Trigal"
>
  <svg 
    xmlns="http://www.w3.org/2000/svg" 
    class={iconSizes[size]} 
    viewBox="0 0 24 24" 
    fill="currentColor"
  >
    <path fill-rule="evenodd" d="M1.5 4.5a3 3 0 013-3h1.372c.86 0 1.61.586 1.819 1.42l1.105 4.423a1.875 1.875 0 01-.694 1.955l-1.293.97c-.135.101-.164.249-.126.352a11.285 11.285 0 006.697 6.697c.103.038.25.009.352-.126l.97-1.293a1.875 1.875 0 011.955-.694l4.423 1.105c.834.209 1.42.959 1.42 1.82V19.5a3 3 0 01-3 3h-2.25C8.552 22.5 1.5 15.448 1.5 6.75V4.5z" clip-rule="evenodd" />
  </svg>
  <span>{locale === 'es' ? 'Llamar al' : 'Call'} {SITE_CONFIG.phone.display}</span>
</a>
