---
import SeoHead from '../seo/SeoHead.astro';
import Header from '../navigation/Header.astro';
import MobileMenu from '../navigation/MobileMenu.astro';
import Footer from '../navigation/Footer.astro';
import MobileBottomBar from '../navigation/MobileBottomBar.astro';
import WhatsAppWidget from '../ui/WhatsAppWidget.astro';
import '../../styles/global.css';
import type { Locale } from '../../types/api';

interface Props {
  title?: string;
  description?: string;
  locale: Locale;
  ogImage?: string;
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
  noindex?: boolean;
  alternateEsRoute?: string;
  alternateEnRoute?: string;
  activeNav?: 'home' | 'menu' | 'products' | 'catering' | 'story' | 'contact';
}

const { title, description, locale = 'es', ogImage, jsonLd, noindex, alternateEsRoute, alternateEnRoute, activeNav } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!xhtml>
<html lang={locale} class="h-full w-full max-w-full overflow-x-hidden bg-brand-cream text-brand-brown">
  <SeoHead
    title={title}
    description={description}
    locale={locale}
    ogImage={ogImage}
    jsonLd={jsonLd}
    noindex={noindex}
    alternateEsRoute={alternateEsRoute}
    alternateEnRoute={alternateEnRoute}
  />
  <body class="min-h-screen w-full max-w-full overflow-x-hidden flex flex-col antialiased selection:bg-brand-gold selection:text-brand-brown bg-brand-cream text-brand-brown relative">
    <!-- Skip to main content link for screen readers -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 z-50 px-4 py-2 bg-brand-gold text-brand-brown font-bold rounded-md shadow-lg"
    >
      {locale === 'es' ? 'Saltar al contenido principal' : 'Skip to main content'}
    </a>

    <Header locale={locale} alternateEsRoute={alternateEsRoute} alternateEnRoute={alternateEnRoute} activeNav={activeNav} />
    <MobileMenu locale={locale} currentPath={currentPath} alternateEsRoute={alternateEsRoute} alternateEnRoute={alternateEnRoute} activeNav={activeNav} />

    <main id="main-content" class="w-full max-w-full overflow-x-hidden flex-grow focus:outline-none pb-16 md:pb-0">
      <slot />
    </main>

    <MobileBottomBar locale={locale} />
    <Footer locale={locale} />
    <WhatsAppWidget locale={locale} />
  </body>
</html>
