---
import { useTranslations } from '../../i18n/utils';
import type { Locale } from '../../types/api';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const apiUrl = import.meta.env.PUBLIC_API_BASE_URL || 'https://el-trigal-backend-nun9.onrender.com/api/v1';
---

<section class="py-16 lg:py-24 bg-brand-cream">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-12 space-y-3">
      <span class="text-xs uppercase tracking-widest font-bold text-brand-gold-secondary">
        ⭐ {locale === 'es' ? 'Los Preferidos de Orange, NJ' : 'Orange, NJ Favorites'}
      </span>
      <h2 class="font-serif text-3xl sm:text-4xl font-bold text-brand-brown">
        {t('home.featuredTitle')}
      </h2>
      <p class="text-brand-brown/80 text-base sm:text-lg">
        {t('home.featuredSubtitle')}
      </p>
    </div>

    <!-- Product Grid (Dynamic) -->
    <div id="featured-products-grid" data-locale={locale} data-api={apiUrl} class="flex flex-wrap justify-center gap-8 min-h-[300px]">
      <!-- Loading Skeleton -->
      <div class="w-full text-center text-brand-brown/50 animate-pulse">
        {locale === 'es' ? 'Cargando los productos más deliciosos...' : 'Loading the most delicious products...'}
      </div>
    </div>

    <!-- View All Button -->
    <div class="mt-12 text-center">
      <a
        href={locale === 'es' ? '/es/catalogo' : '/en/catalog'}
        class="inline-flex items-center space-x-2 px-8 py-3.5 rounded-full bg-brand-brown text-brand-gold font-bold text-sm hover:bg-brand-brown-dark border-2 border-brand-gold shadow-md transition-all"
      >
        <span>{locale === 'es' ? 'Ver Todo el Catálogo' : 'View Full Catalog'}</span>
        <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
        </svg>
      </a>
    </div>

  </div>
</section>

<script>
  function formatPriceCents(cents: any, locale: any) {
    return new Intl.NumberFormat(locale === 'es' ? 'es-US' : 'en-US', {
      style: 'currency',
      currency: 'USD',
    }).format(cents / 100);
  }

  async function loadFeaturedProducts() {
    const grid = document.getElementById('featured-products-grid');
    if (!grid) return;

    const locale = grid.dataset.locale as string;
    const isLocalhost = window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1';
    const apiUrl = isLocalhost ? '/api/v1' : (grid.dataset.api || '/api/v1');

    async function fetchProductsData() {
      const res = await fetch(`${apiUrl}/public/products?featured=true&limit=6`);
      if (!res.ok) throw new Error('API Error');
      return await res.json();
    }

    try {
      const data = await fetchProductsData();
      const products = data.data || [];

      if (products.length === 0) {
        grid.innerHTML = `<div class="w-full text-center text-brand-brown/50">${locale === 'es' ? 'No hay productos destacados por ahora.' : 'No featured products at the moment.'}</div>`;
        return;
      }

      grid.innerHTML = products.map((product: any) => {
        const primaryImage = product.media?.find((m: any) => m.isPrimary) || product.media?.[0];
        const imageUrl = primaryImage ? (primaryImage.secureUrl || primaryImage.url || '') : '';
        const altText = primaryImage ? ((primaryImage.alt?.[locale]) || (primaryImage.altText?.[locale]) || (product.name?.[locale]) || '') : '';
        
        const prodSlug = typeof product.slug === 'object' ? (product.slug?.[locale] || product.slug?.es || product.slug?.en || '') : (product.slug || '');
        const prodName = typeof product.name === 'object' ? (product.name?.[locale] || product.name?.es || product.name?.en || '') : (product.name || '');

        const productUrl = locale === 'es'
          ? `/es/productos/${prodSlug}`
          : `/en/products/${prodSlug}`;

        const formattedPrice = product.priceLabel?.[locale]
          ? product.priceLabel[locale]
          : product.basePriceCents
          ? formatPriceCents(product.basePriceCents, locale)
          : null;

        const catName = product.primaryCategory?.name?.[locale] || product.primaryCategory?.name?.es || '';
        const desc = product.shortDescription?.[locale] || product.shortDescription?.es || product.description?.[locale] || '';

        return `
          <div class="w-full sm:w-[calc(50%-1rem)] lg:w-[calc(33.333%-1.5rem)] max-w-sm">
            <article class="bg-brand-cream border border-brand-gold/30 rounded-2xl overflow-hidden shadow-warm hover:shadow-warm-hover transition-all duration-300 flex flex-col group h-full">
              <a href="${productUrl}" class="relative block overflow-hidden aspect-[4/3] bg-brand-cream-dark">
                ${imageUrl ? `
                  <img src="${imageUrl}" alt="${altText}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
                ` : `
                  <div class="w-full h-full flex items-center justify-center text-4xl text-brand-gold-secondary">🍞</div>
                `}
              </a>
              <div class="p-5 flex flex-col flex-grow space-y-2">
                <div class="flex flex-wrap items-center justify-between gap-1">
                  <span class="text-xs font-semibold text-brand-gold-secondary uppercase tracking-wider">${catName}</span>
                  <span class="flex items-center gap-1 bg-brand-brown text-brand-gold text-[10px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full">🚚 Delivery</span>
                </div>
                <h3 class="font-serif font-bold text-xl text-brand-brown group-hover:text-brand-brown-dark transition-colors line-clamp-1">
                  <a href="${productUrl}" class="focus:outline-none focus:underline">${prodName}</a>
                </h3>
                <p class="text-xs sm:text-sm text-brand-brown/75 line-clamp-2 leading-relaxed flex-grow">${desc}</p>
                <div class="pt-2 flex items-center justify-between border-t border-brand-gold/20">
                  ${formattedPrice ? `
                    <span class="font-serif font-extrabold text-xl text-brand-brown">${formattedPrice}</span>
                  ` : `
                    <span class="text-xs text-brand-brown/50 italic">${locale === 'es' ? 'Consultar precio' : 'Ask for price'}</span>
                  `}
                  <a href="${productUrl}" class="text-xs font-bold text-brand-brown/60 hover:text-brand-brown underline-offset-2 hover:underline transition-colors">
                    ${locale === 'es' ? 'Ver más →' : 'View →'}
                  </a>
                </div>
              </div>
            </article>
          </div>
        `;
      }).join('');

    } catch (error) {
      console.error('Error fetching featured products:', error);
      grid.innerHTML = `<div class="w-full text-center text-red-500/80">${locale === 'es' ? 'Error al cargar los productos.' : 'Error loading products.'}</div>`;
    }
  }

  loadFeaturedProducts();
  document.addEventListener('DOMContentLoaded', loadFeaturedProducts);
  document.addEventListener('astro:page-load', loadFeaturedProducts);
</script>
