---
import { useTranslations } from '../../i18n/utils';
import type { Locale } from '../../types/api';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section class="py-16 lg:py-24 bg-brand-cream border-t border-brand-gold/20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-3">
      <span class="text-xs uppercase tracking-widest font-bold text-brand-gold-secondary">
        📋 {locale === 'es' ? 'Paso a Paso' : 'Step by Step'}
      </span>
      <h2 class="font-serif text-3xl sm:text-4xl font-bold text-brand-brown">
        {t('home.processTitle')}
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      
      <!-- Step 1 -->
      <div class="bg-brand-cream-dark/60 p-8 rounded-2xl border-2 border-brand-gold/30 relative space-y-4 shadow-warm">
        <div class="w-12 h-12 rounded-full bg-brand-brown text-brand-gold font-serif font-bold text-xl flex items-center justify-center border-2 border-brand-gold shadow">
          1
        </div>
        <h3 class="font-serif font-bold text-xl text-brand-brown">
          {t('home.processStep1Title')}
        </h3>
        <p class="text-sm text-brand-brown/80 leading-relaxed">
          {t('home.processStep1Text')}
        </p>
      </div>

      <!-- Step 2 -->
      <div class="bg-brand-cream-dark/60 p-8 rounded-2xl border-2 border-brand-gold/30 relative space-y-4 shadow-warm">
        <div class="w-12 h-12 rounded-full bg-brand-brown text-brand-gold font-serif font-bold text-xl flex items-center justify-center border-2 border-brand-gold shadow">
          2
        </div>
        <h3 class="font-serif font-bold text-xl text-brand-brown">
          {t('home.processStep2Title')}
        </h3>
        <p class="text-sm text-brand-brown/80 leading-relaxed">
          {t('home.processStep2Text')}
        </p>
      </div>

      <!-- Step 3 -->
      <div class="bg-brand-cream-dark/60 p-8 rounded-2xl border-2 border-brand-gold/30 relative space-y-4 shadow-warm">
        <div class="w-12 h-12 rounded-full bg-brand-brown text-brand-gold font-serif font-bold text-xl flex items-center justify-center border-2 border-brand-gold shadow">
          3
        </div>
        <h3 class="font-serif font-bold text-xl text-brand-brown">
          {t('home.processStep3Title')}
        </h3>
        <p class="text-sm text-brand-brown/80 leading-relaxed">
          {t('home.processStep3Text')}
        </p>
      </div>

    </div>

    <div class="mt-12 text-center">
      <a
        href={locale === 'es' ? '/es/pasteles-personalizados#cotizar' : '/en/custom-cakes#quote'}
        class="inline-block px-8 py-4 rounded-full bg-brand-gold text-brand-brown font-bold text-base hover:bg-brand-gold-secondary shadow-lg transition-all"
      >
        {locale === 'es' ? 'Iniciar Cotización de Pastel' : 'Start Cake Quote'} →
      </a>
    </div>
  </div>
</section>
