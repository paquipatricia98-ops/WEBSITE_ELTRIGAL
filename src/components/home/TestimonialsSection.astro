---
import { getTestimonials } from '../../services/api/publicApi';
import { useTranslations } from '../../i18n/utils';
import type { Locale } from '../../types/api';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const testimonials = await getTestimonials(locale);
---

<section class="py-16 lg:py-24 bg-brand-cream-dark/50 border-t border-brand-gold/20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-12 space-y-3">
      <span class="text-xs uppercase tracking-widest font-bold text-brand-gold-secondary">
        💬 {locale === 'es' ? 'Reseñas Reales' : 'Real Customer Reviews'}
      </span>
      <h2 class="font-serif text-3xl sm:text-4xl font-bold text-brand-brown">
        {t('home.testimonialsTitle')}
      </h2>
      <p class="text-brand-brown/80 text-base sm:text-lg">
        {t('home.testimonialsSubtitle')}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {
        testimonials.map((item) => (
          <div class="bg-brand-cream p-8 rounded-2xl border border-brand-gold/30 shadow-warm flex flex-col justify-between space-y-4">
            <div class="space-y-3">
              <div class="flex text-brand-gold text-lg">
                {Array.from({ length: item.rating }).map(() => (
                  <span>★</span>
                ))}
              </div>
              <p class="text-sm text-brand-brown/90 italic leading-relaxed">
                "{item.content[locale]}"
              </p>
            </div>
            <div class="pt-4 border-t border-brand-brown/10 flex items-center justify-between">
              <div>
                <div class="font-serif font-bold text-sm text-brand-brown">{item.authorName}</div>
                <div class="text-xs text-brand-gold-secondary font-semibold">{item.authorLocation}</div>
              </div>
              <div class="w-8 h-8 rounded-full bg-brand-brown text-brand-gold flex items-center justify-center font-bold text-xs">
                🇪🇨
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
