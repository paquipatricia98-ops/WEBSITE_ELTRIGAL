---
import { useTranslations } from '../../i18n/utils';
import type { Locale } from '../../types/api';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section class="py-16 lg:py-24 bg-brand-cream-dark/50 border-t border-brand-gold/20">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6">
    <span class="text-xs uppercase tracking-widest font-bold text-brand-gold-secondary">
      🏙️ {locale === 'es' ? 'Herencia y Amor por Nuestra Tierra' : 'Heritage & Love for Our Homeland'}
    </span>
    <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-brand-brown">
      {t('home.historyTitle')}
    </h2>
    <p class="text-base sm:text-xl text-brand-brown/85 leading-relaxed max-w-3xl mx-auto">
      {t('home.historyText')}
    </p>
    <div class="pt-4">
      <a
        href={locale === 'es' ? '/es/nuestra-historia' : '/en/our-story'}
        class="inline-block px-8 py-3.5 rounded-full bg-brand-gold text-brand-brown font-bold text-sm hover:bg-brand-gold-secondary shadow-md transition-all"
      >
        {t('home.historyCta')} →
      </a>
    </div>
  </div>
</section>
