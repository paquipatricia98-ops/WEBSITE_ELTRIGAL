---
import { getGallery } from '../../services/api/publicApi';
import CloudinaryImage from '../ui/CloudinaryImage.astro';
import type { Locale } from '../../types/api';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const galleryItems = await getGallery(1, 4);
---

<section class="py-16 lg:py-24 bg-brand-cream border-t border-brand-gold/20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-12 space-y-3">
      <span class="text-xs uppercase tracking-widest font-bold text-brand-gold-secondary">
        📸 {locale === 'es' ? 'Galería de Fotos' : 'Photo Gallery'}
      </span>
      <h2 class="font-serif text-3xl sm:text-4xl font-bold text-brand-brown">
        {locale === 'es' ? 'Nuestras Creaciones Artesanales' : 'Our Artisanal Creations'}
      </h2>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      {
        galleryItems.map((item) => (
          <div class="group relative rounded-2xl overflow-hidden shadow-warm border border-brand-gold/30 aspect-square bg-brand-brown">
            <CloudinaryImage
              src={item.secureUrl}
              alt={item.altText[locale]}
              width={500}
              height={500}
              class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-brand-brown/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity p-4 flex flex-col justify-end">
              <span class="font-serif font-bold text-brand-gold text-sm">
                {item.title[locale]}
              </span>
            </div>
          </div>
        ))
      }
    </div>

    <div class="mt-8 text-center">
      <a
        href={locale === 'es' ? '/es/galeria' : '/en/gallery'}
        class="inline-block px-6 py-2.5 rounded-full bg-brand-brown text-brand-gold font-bold text-xs hover:bg-brand-brown-dark border border-brand-gold transition-all"
      >
        {locale === 'es' ? 'Ver Galería Completa' : 'View Full Gallery'} →
      </a>
    </div>
  </div>
</section>
