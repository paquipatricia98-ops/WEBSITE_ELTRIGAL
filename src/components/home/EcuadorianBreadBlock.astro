---
import { useTranslations } from '../../i18n/utils';
import CloudinaryImage from '../ui/CloudinaryImage.astro';
import type { Locale } from '../../types/api';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section class="py-16 lg:py-24 bg-brand-brown text-brand-cream border-t-4 border-brand-gold relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <div class="lg:col-span-6 space-y-6">
        <div class="inline-flex items-center space-x-2 px-4 py-1.5 rounded-full bg-brand-gold/20 text-brand-gold border border-brand-gold/40 text-xs font-bold uppercase tracking-wider">
          <span>🥐</span>
          <span>{locale === 'es' ? 'SABORES QUE NOS CONECTAN CON ECUADOR' : 'Ambato Tradition'}</span>
        </div>

        <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-brand-cream leading-tight">
          {t('home.ecuadorianBreadTitle')}
        </h2>

        <p class="text-base sm:text-lg text-brand-cream/85 leading-relaxed">
          {t('home.ecuadorianBreadText')}
        </p>

        <div class="grid grid-cols-2 gap-4 py-2">
          <div class="bg-brand-cream/10 p-4 rounded-xl border border-brand-gold/30">
            <div class="font-serif font-bold text-brand-gold text-lg">Productos Horneados</div>
            <div class="text-xs text-brand-cream/70">{locale === 'es' ? 'Frescos, variados y preparados artesanalmente.' : 'Savory & flaky'}</div>
          </div>
          <div class="bg-brand-cream/10 p-4 rounded-xl border border-brand-gold/30">
            <div class="font-serif font-bold text-brand-gold text-lg">Pasteles Personalizados</div>
            <div class="text-xs text-brand-cream/70">{locale === 'es' ? 'Diseños especiales para cumpleaños y celebraciones.' : 'Crispy crust'}</div>
          </div>
          <div class="bg-brand-cream/10 p-4 rounded-xl border border-brand-gold/30">
            <div class="font-serif font-bold text-brand-gold text-lg">Smoothies y Bebidas</div>
            <div class="text-xs text-brand-cream/70">{locale === 'es' ? 'Opciones refrescantes, deliciosas y hechas al momento.' : 'Fresh cheese & sugar'}</div>
          </div>
          <div class="bg-brand-cream/10 p-4 rounded-xl border border-brand-gold/30">
            <div class="font-serif font-bold text-brand-gold text-lg">Postres Caseros</div>
            <div class="text-xs text-brand-cream/70">{locale === 'es' ? 'Pan de chocolate, helado de mango y mucho más.' : 'Achira starch'}</div>
          </div>
        </div>

        <div class="pt-2">
          <a
            href={locale === 'es' ? '/es/menu' : '/en/menu'}
            class="inline-block px-8 py-4 rounded-full bg-brand-gold text-brand-brown font-bold text-base hover:bg-brand-gold-secondary shadow-lg transition-all"
          >
            {t('home.ecuadorianBreadCta')} →
          </a>
        </div>
      </div>

      <div class="lg:col-span-6">
        <div class="relative rounded-3xl overflow-hidden shadow-2xl border-4 border-brand-gold">
          <CloudinaryImage
            src="https://images.unsplash.com/photo-1509440159596-0249088772ff?w=1000&auto=format&fit=crop&q=80"
            alt="Pan ecuatoriano recién horneado El Trigal Orange NJ"
            width={800}
            height={600}
            class="w-full h-[400px] lg:h-[500px] object-cover"
          />
          <div class="absolute bottom-4 right-4 bg-brand-brown/90 px-4 py-2 rounded-xl border border-brand-gold text-xs font-bold text-brand-gold">
            ✨ {locale === 'es' ? 'Frescura, tradición y sabor ecuatoriano' : 'Baked fresh daily from 6:00 AM'}
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
