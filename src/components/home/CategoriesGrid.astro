---
import { useTranslations } from '../../i18n/utils';
import type { Locale } from '../../types/api';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const apiUrl = import.meta.env.PUBLIC_API_BASE_URL || 'https://el-trigal-backend-nun9.onrender.com/api/v1';
---

<section class="py-16 lg:py-24 bg-brand-cream-dark overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-12 space-y-3">
      <span class="text-xs uppercase tracking-widest font-bold text-brand-gold-secondary">
        🍰 {locale === 'es' ? 'Nuestras Especialidades' : 'Our Specialties'}
      </span>
      <h2 class="font-serif text-3xl sm:text-4xl font-bold text-brand-brown">
        {locale === 'es' ? 'Explora los Catálogos' : 'Explore the Catalogs'}
      </h2>
      <p class="text-brand-brown/80 text-base sm:text-lg">
        {locale === 'es' 
          ? 'Explora los catálogos de nuestros productos recomendados' 
          : 'Explore the catalogs of our recommended products'}
      </p>
    </div>

    <!-- Centered Pinterest Grid Wrapper -->
    <div class="max-w-7xl mx-auto px-4 py-4">
      <div class="catalogs-pinterest-grid w-full mx-auto" data-locale={locale} data-api={apiUrl}>
        <!-- Dynamic catalog cards will be rendered here -->
        <div class="w-full text-center py-12 text-brand-brown/50 italic animate-pulse">
          {locale === 'es' ? 'Cargando catálogos destacados...' : 'Loading featured catalogs...'}
        </div>
      </div>
    </div>

  </div>
</section>

<script>
  async function fetchAndRenderFeaturedCatalogs() {
    const container = document.querySelector('.catalogs-pinterest-grid') as HTMLElement;
    if (!container) return;

    const locale = container.dataset.locale as string;
    const isLocalhost = window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1';
    const apiUrl = isLocalhost ? '/api/v1' : (container.dataset.api || '/api/v1');

    async function fetchFeaturedCatalogsData() {
      const res = await fetch(`${apiUrl}/public/catalogs/featured?locale=${locale}`);
      if (!res.ok) throw new Error('Error fetching featured catalogs');
      return await res.json();
    }

    try {
      const resData = await fetchFeaturedCatalogsData();
      const categories = resData.data || [];

      if (categories.length === 0) {
        container.className = 'catalogs-pinterest-grid w-full';
        container.innerHTML = `<div class="text-center py-12 text-brand-brown/50 w-full">${locale === 'es' ? 'No hay catálogos destacados disponibles en este momento.' : 'No featured catalogs available at the moment.'}</div>`;
        return;
      }

      function renderCategoryCard(cat: any) {
        const catSlug = cat.slug?.[locale] || cat.slug?.es || cat.slug?.en || cat.id || cat._id;
        const categoryUrl = locale === 'es' ? `/es/catalogo?category=${catSlug}` : `/en/catalog?category=${catSlug}`;

        const dbImage = typeof cat.image === 'object' && cat.image 
          ? (cat.image.secureUrl || cat.image.url) 
          : (typeof cat.image === 'string' ? cat.image : null);
        
        const catName = cat.name?.[locale] || cat.name?.es || '';
        const catDesc = cat.description?.[locale] || cat.description?.es || '';
        const browseText = locale === 'es' ? 'Ver catálogo completo' : 'View full catalog';

        if (dbImage) {
          return `
            <a href="${categoryUrl}" class="pinterest-card w-full rounded-3xl overflow-hidden bg-brand-cream border-2 border-brand-gold/30 hover:border-brand-gold hover:shadow-lg hover:scale-[1.01] transition-all duration-300 shadow-sm p-4 text-left animate-fade-in block">
              <div class="relative overflow-hidden rounded-2xl mb-4 border border-brand-gold/15 bg-brand-cream-dark">
                <img src="${dbImage}" alt="${catName}" class="w-full h-auto object-cover rounded-xl" loading="lazy" onerror="this.onerror=null; this.src='/images/history/interior.jpg';" />
              </div>
              <div class="space-y-2">
                <h3 class="font-serif text-xl sm:text-2xl font-bold text-brand-brown">${catName}</h3>
                ${catDesc ? `<p class="text-xs sm:text-sm text-brand-brown/85 leading-relaxed">${catDesc}</p>` : ''}
              </div>
              <div class="pt-4 mt-4 border-t border-brand-gold/15 flex items-center text-xs font-bold text-brand-gold-secondary">
                <span>${browseText} →</span>
              </div>
            </a>
          `;
        } else {
          return `
            <a href="${categoryUrl}" class="pinterest-card w-full rounded-3xl overflow-hidden bg-brand-cream border-2 border-brand-gold/30 hover:border-brand-gold hover:shadow-lg hover:scale-[1.01] transition-all duration-300 shadow-sm p-5 text-left animate-fade-in block">
              <div class="w-12 h-12 rounded-2xl bg-brand-gold/15 border border-brand-gold/30 flex items-center justify-center text-brand-gold-secondary mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                  <circle cx="8.5" cy="8.5" r="1.5"/>
                  <polyline points="21 15 16 10 5 21"/>
                </svg>
              </div>
              <div class="space-y-2">
                <h3 class="font-serif text-xl sm:text-2xl font-bold text-brand-brown">${catName}</h3>
                ${catDesc ? `<p class="text-xs sm:text-sm text-brand-brown/85 leading-relaxed">${catDesc}</p>` : ''}
              </div>
              <div class="pt-4 mt-4 border-t border-brand-gold/15 flex items-center text-xs font-bold text-brand-gold-secondary">
                <span>${browseText} →</span>
              </div>
            </a>
          `;
        }
      }

      // Configure dynamic grid columns and max-width based on the number of items to prevent empty columns
      const numItems = categories.length;
      const numColumns = Math.min(numItems, 4);
      let gridClass = "grid gap-6 items-start justify-center";
      let maxWClass = "max-w-7xl";
      if (numColumns === 1) {
        gridClass += " grid-cols-1";
        maxWClass = "max-w-sm";
      } else if (numColumns === 2) {
        gridClass += " grid-cols-1 sm:grid-cols-2";
        maxWClass = "max-w-3xl";
      } else if (numColumns === 3) {
        gridClass += " grid-cols-1 sm:grid-cols-2 md:grid-cols-3";
        maxWClass = "max-w-5xl";
      } else {
        gridClass += " grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4";
        maxWClass = "max-w-7xl";
      }
      container.className = `catalogs-pinterest-grid ${gridClass} ${maxWClass} w-full mx-auto`;

      let columnsHtml = "";
      for (let i = 0; i < numColumns; i++) {
        columnsHtml += `<div class="flex flex-col gap-6 w-full" id="cat-col-${i}"></div>`;
      }
      container.innerHTML = columnsHtml;

      categories.forEach((cat: any, index: number) => {
        const colIndex = index % numColumns;
        const colDiv = container.querySelector(`#cat-col-${colIndex}`);
        if (colDiv) {
          colDiv.innerHTML += renderCategoryCard(cat);
        }
      });
    } catch (err) {
      console.error(err);
      container.innerHTML = `<div class="text-center py-12 text-red-500 w-full">${locale === 'es' ? 'Error al cargar los catálogos.' : 'Error loading catalogs.'}</div>`;
    }
  }

  fetchAndRenderFeaturedCatalogs();
  document.addEventListener('DOMContentLoaded', fetchAndRenderFeaturedCatalogs);
  document.addEventListener('astro:page-load', fetchAndRenderFeaturedCatalogs);
</script>
