---
import { getCategories } from '../../services/api/publicApi';
import { useTranslations } from '../../i18n/utils';
import CloudinaryImage from '../ui/CloudinaryImage.astro';
import type { Locale } from '../../types/api';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const categories = await getCategories(locale);
---

<section class="py-16 lg:py-24 bg-brand-cream-dark/60 border-t border-brand-gold/20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-12 space-y-3">
      <span class="text-xs uppercase tracking-widest font-bold text-brand-gold-secondary">
        🍰 {locale === 'es' ? 'Variedad Artesanal' : 'Artisanal Variety'}
      </span>
      <h2 class="font-serif text-3xl sm:text-4xl font-bold text-brand-brown">
        {t('home.categoriesTitle')}
      </h2>
      <p class="text-brand-brown/80 text-base sm:text-lg">
        {t('home.categoriesSubtitle')}
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        categories.map((cat) => {
          const categoryUrl = `/${locale}/menu/${cat.slug[locale] || cat.slug.es}`;
          const dbImage = typeof cat.imageUrl === 'object' && cat.imageUrl 
            ? ((cat.imageUrl as any).secureUrl || (cat.imageUrl as any).url) 
            : (typeof cat.imageUrl === 'string' ? cat.imageUrl : null);

          return (
            <a
              href={categoryUrl}
              class={`group relative rounded-2xl overflow-hidden shadow-sm hover:shadow-warm border block h-64 transition-all duration-300 transform hover:-translate-y-1 ${
                dbImage 
                  ? 'bg-brand-brown border-brand-gold/30' 
                  : 'bg-brand-cream border-brand-gold/40'
              }`}
            >
              {
                dbImage ? (
                  <>
                    <img
                      src={dbImage}
                      alt={cat.name[locale]}
                      width="600"
                      height="400"
                      class="w-full h-full object-cover opacity-70 group-hover:opacity-85 group-hover:scale-105 transition-all duration-500"
                      loading="lazy"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-brand-brown via-brand-brown/40 to-transparent p-6 flex flex-col justify-end">
                      <h3 class="font-serif text-2xl font-bold text-brand-gold group-hover:text-brand-cream transition-colors">
                        {cat.name[locale]}
                      </h3>
                      {
                        cat.description && (
                          <p class="text-xs sm:text-sm text-brand-cream/80 line-clamp-2 mt-1">
                            {cat.description[locale]}
                          </p>
                        )
                      }
                      <div class="mt-3 flex items-center text-xs font-bold text-brand-gold group-hover:translate-x-1 transition-transform">
                        <span>{locale === 'es' ? 'Ver productos' : 'Browse items'} →</span>
                      </div>
                    </div>
                  </>
                ) : (
                  <div class="h-full p-6 flex flex-col justify-between">
                    <div class="w-12 h-12 rounded-xl bg-brand-gold/10 border border-brand-gold/20 flex items-center justify-center text-brand-gold-secondary group-hover:scale-110 transition-transform duration-300">
                      <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                        <circle cx="8.5" cy="8.5" r="1.5"/>
                        <polyline points="21 15 16 10 5 21"/>
                      </svg>
                    </div>
                    <div class="space-y-1">
                      <h3 class="font-serif text-2xl font-bold text-brand-brown group-hover:text-brand-gold-secondary transition-colors">
                        {cat.name[locale]}
                      </h3>
                      {
                        cat.description && (
                          <p class="text-xs sm:text-sm text-brand-brown/70 line-clamp-2">
                            {cat.description[locale]}
                          </p>
                        )
                      }
                      <div class="pt-2 flex items-center text-xs font-bold text-brand-gold-secondary group-hover:translate-x-1 transition-transform">
                        <span>{locale === 'es' ? 'Ver productos' : 'Browse items'} →</span>
                      </div>
                    </div>
                  </div>
                )
              }
            </a>
          );
        })
      }
    </div>

  </div>
</section>
