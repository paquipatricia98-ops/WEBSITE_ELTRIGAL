---
import { getCategories } from '../../services/api/publicApi';
import { useTranslations } from '../../i18n/utils';
import CloudinaryImage from '../ui/CloudinaryImage.astro';
import type { Locale } from '../../types/api';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const categories = await getCategories(locale);
---

<section class="py-16 lg:py-24 bg-brand-cream-dark/60 border-t border-brand-gold/20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-12 space-y-3">
      <span class="text-xs uppercase tracking-widest font-bold text-brand-gold-secondary">
        🍰 {locale === 'es' ? 'Variedad Artesanal' : 'Artisanal Variety'}
      </span>
      <h2 class="font-serif text-3xl sm:text-4xl font-bold text-brand-brown">
        {t('home.categoriesTitle')}
      </h2>
      <p class="text-brand-brown/80 text-base sm:text-lg">
        {t('home.categoriesSubtitle')}
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        categories.map((cat) => {
          const categoryUrl = `/${locale}/menu/${cat.slug[locale] || cat.slug.es}`;
          return (
            <a
              href={categoryUrl}
              class="group relative rounded-2xl overflow-hidden shadow-warm hover:shadow-warm-hover border border-brand-gold/30 block bg-brand-brown h-64 transition-all duration-300 transform hover:-translate-y-1"
            >
              {
                cat.imageUrl && (
                  <CloudinaryImage
                    src={cat.imageUrl}
                    alt={cat.name[locale]}
                    width={600}
                    height={400}
                    class="w-full h-full object-cover opacity-70 group-hover:opacity-85 group-hover:scale-105 transition-all duration-500"
                  />
                )
              }
              <div class="absolute inset-0 bg-gradient-to-t from-brand-brown via-brand-brown/40 to-transparent p-6 flex flex-col justify-end">
                <h3 class="font-serif text-2xl font-bold text-brand-gold group-hover:text-brand-cream transition-colors">
                  {cat.name[locale]}
                </h3>
                {
                  cat.description && (
                    <p class="text-xs sm:text-sm text-brand-cream/80 line-clamp-2 mt-1">
                      {cat.description[locale]}
                    </p>
                  )
                }
                <div class="mt-3 flex items-center text-xs font-bold text-brand-gold group-hover:translate-x-1 transition-transform">
                  <span>{locale === 'es' ? 'Ver productos' : 'Browse items'} →</span>
                </div>
              </div>
            </a>
          );
        })
      }
    </div>

  </div>
</section>
