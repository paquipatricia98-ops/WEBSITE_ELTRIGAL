---
import { getCategories } from '../../services/api/publicApi';
import { useTranslations } from '../../i18n/utils';

import type { Locale } from '../../types/api';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const categories = await getCategories(locale);
---

<section class="py-16 lg:py-24 bg-brand-cream-dark/60 border-t border-brand-gold/20 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-12 space-y-3">
      <span class="text-xs uppercase tracking-widest font-bold text-brand-gold-secondary">
        🍰 {locale === 'es' ? 'Variedad Artesanal' : 'Artisanal Variety'}
      </span>
      <h2 class="font-serif text-3xl sm:text-4xl font-bold text-brand-brown">
        {t('home.categoriesTitle')}
      </h2>
      <p class="text-brand-brown/80 text-base sm:text-lg">
        {t('home.categoriesSubtitle')}
      </p>
    </div>

    <!-- 3D Cover Flow Slider Wrapper -->
    <div class="relative max-w-5xl mx-auto px-4 py-8">
      <div class="coverflow-container relative h-[400px] w-full flex items-center justify-center" style="perspective: 1200px; transform-style: preserve-3d;">
        {
          categories.map((cat) => {
            const categoryUrl = `/${locale}/menu/${cat.slug[locale] || cat.slug.es}`;
            const dbImage = typeof cat.imageUrl === 'object' && cat.imageUrl 
              ? ((cat.imageUrl as any).secureUrl || (cat.imageUrl as any).url) 
              : (typeof cat.imageUrl === 'string' ? cat.imageUrl : null);

            return (
              <a
                href={categoryUrl}
                class={`coverflow-card absolute w-[260px] sm:w-[320px] h-[360px] rounded-2xl overflow-hidden shadow-warm border block transition-all duration-500 ease-out origin-center cursor-pointer ${
                  dbImage 
                    ? 'bg-brand-brown border-brand-gold/30' 
                    : 'bg-brand-cream border-brand-gold/45'
                }`}
                style="will-change: transform, opacity;"
              >
                {
                  dbImage ? (
                    <>
                      <img
                        src={dbImage}
                        alt={cat.name[locale]}
                        width="600"
                        height="400"
                        class="w-full h-full object-cover transition-all duration-500"
                        loading="lazy"
                      />
                      <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent p-6 flex flex-col justify-end">
                        <h3 class="font-serif text-2xl font-bold text-white transition-colors">
                          {cat.name[locale]}
                        </h3>
                        {
                          cat.description && (
                            <p class="text-xs sm:text-sm text-brand-cream/80 line-clamp-2 mt-1">
                              {cat.description[locale]}
                            </p>
                          )
                        }
                        <div class="mt-3 flex items-center text-xs font-bold text-brand-gold">
                          <span>{locale === 'es' ? 'Ver productos' : 'Browse items'} →</span>
                        </div>
                      </div>
                    </>
                  ) : (
                    <div class="h-full p-6 flex flex-col justify-between">
                      <div class="w-12 h-12 rounded-xl bg-brand-gold/10 border border-brand-gold/20 flex items-center justify-center text-brand-gold-secondary">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                          <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                          <circle cx="8.5" cy="8.5" r="1.5"/>
                          <polyline points="21 15 16 10 5 21"/>
                        </svg>
                      </div>
                      <div class="space-y-1">
                        <h3 class="font-serif text-2xl font-bold text-brand-brown transition-colors">
                          {cat.name[locale]}
                        </h3>
                        {
                          cat.description && (
                            <p class="text-xs sm:text-sm text-brand-brown/70 line-clamp-2">
                              {cat.description[locale]}
                            </p>
                          )
                        }
                        <div class="pt-2 flex items-center text-xs font-bold text-brand-gold-secondary">
                          <span>{locale === 'es' ? 'Ver productos' : 'Browse items'} →</span>
                        </div>
                      </div>
                    </div>
                  )
                }
              </a>
            );
          })
        }
      </div>

      <!-- Controls Wrapper (Buttons and Dots aligned like User Screenshot) -->
      <div class="flex items-center justify-center gap-6 mt-8">
        <div class="flex gap-2">
          <button class="coverflow-prev w-10 h-10 rounded-xl bg-brand-brown text-brand-gold border border-brand-gold/20 flex items-center justify-center hover:bg-brand-brown-dark hover:scale-105 transition-all shadow-sm" aria-label="Previous category">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <polyline points="15 18 9 12 15 6"/>
            </svg>
          </button>
          <button class="coverflow-next w-10 h-10 rounded-xl bg-brand-brown text-brand-gold border border-brand-gold/20 flex items-center justify-center hover:bg-brand-brown-dark hover:scale-105 transition-all shadow-sm" aria-label="Next category">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <polyline points="9 18 15 12 9 6"/>
            </svg>
          </button>
        </div>
        <div class="coverflow-dots flex items-center gap-2">
          <!-- Dots dynamically created via JS -->
        </div>
      </div>
    </div>

  </div>
</section>

<script>
  function initCoverflow() {
    const container = document.querySelector('.coverflow-container');
    if (!container) return;
    
    const cards = container.querySelectorAll('.coverflow-card');
    const prevBtn = document.querySelector('.coverflow-prev');
    const nextBtn = document.querySelector('.coverflow-next');
    const dotsContainer = document.querySelector('.coverflow-dots');
    if (!cards.length) return;
    let activeIndex = Math.floor(cards.length / 2);

    // Create pagination dots
    if (dotsContainer) {
      dotsContainer.innerHTML = '';
      cards.forEach((_, idx) => {
        const dot = document.createElement('button');
        dot.className = `w-2.5 h-2.5 rounded-full transition-all duration-300 ${idx === activeIndex ? 'bg-brand-gold-secondary scale-125' : 'bg-brand-brown/25'}`;
        dot.setAttribute('aria-label', `Go to slide ${idx + 1}`);
        dot.addEventListener('click', () => {
          activeIndex = idx;
          updateCoverflow();
        });
        dotsContainer.appendChild(dot);
      });
    }

    let autoplayTimeout: any;
    let autoplayDirection = 1;

    function startAutoplay() {
      if (autoplayTimeout) clearTimeout(autoplayTimeout);
      // Generate a random time between 3 and 7 seconds (3000ms to 7000ms)
      const randomTime = Math.floor(Math.random() * (7000 - 3000 + 1)) + 3000;
      autoplayTimeout = setTimeout(() => {
        if (activeIndex === cards.length - 1) {
          autoplayDirection = -1;
        } else if (activeIndex === 0) {
          autoplayDirection = 1;
        }
        activeIndex = activeIndex + autoplayDirection;
        if (activeIndex < 0) activeIndex = 0;
        if (activeIndex >= cards.length) activeIndex = cards.length - 1;
        updateCoverflow();
      }, randomTime);
    }

    function updateCoverflow() {
      const isMobile = window.innerWidth < 640;
      // Adjust spacing factor based on screen size
      const spacing = isMobile ? 80 : 130;
      const zOffset = isMobile ? -150 : -220;
      const angle = isMobile ? 30 : 40;

      cards.forEach((card, idx) => {
        const offset = idx - activeIndex;
        const absOffset = Math.abs(offset);
        
        let transformStr = '';
        let zIndex = 10 - absOffset;
        let opacity = 1;
        let pointerEvents = 'auto';

        if (offset === 0) {
          transformStr = 'translate3d(0, 0, 50px) scale(1.05) rotateY(0deg)';
          opacity = 1;
          pointerEvents = 'auto';
        } else if (offset < 0) {
          const translateX = offset * spacing - (isMobile ? 20 : 40);
          transformStr = `translate3d(${translateX}px, 0, ${zOffset}px) scale(0.85) rotateY(${angle}deg)`;
          opacity = Math.max(0.1, 1 - absOffset * 0.35);
          pointerEvents = 'none';
        } else {
          const translateX = offset * spacing + (isMobile ? 20 : 40);
          transformStr = `translate3d(${translateX}px, 0, ${zOffset}px) scale(0.85) rotateY(${-angle}deg)`;
          opacity = Math.max(0.1, 1 - absOffset * 0.35);
          pointerEvents = 'none';
        }

        (card as HTMLElement).style.transform = transformStr;
        (card as HTMLElement).style.zIndex = zIndex.toString();
        (card as HTMLElement).style.opacity = opacity.toString();
        (card as HTMLElement).style.pointerEvents = pointerEvents;
      });

      // Update dots styles
      if (dotsContainer) {
        const dots = dotsContainer.querySelectorAll('button');
        dots.forEach((dot, idx) => {
          if (idx === activeIndex) {
            dot.className = 'w-3.5 h-3.5 rounded-full transition-all duration-300 bg-brand-gold-secondary scale-125';
          } else {
            dot.className = 'w-2.5 h-2.5 rounded-full transition-all duration-300 bg-brand-brown/25 hover:bg-brand-brown/40';
          }
        });
      }

      // Schedule next autoplay slide with new random duration
      startAutoplay();
    }

    // Attach control listeners
    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        activeIndex = (activeIndex - 1 + cards.length) % cards.length;
        updateCoverflow();
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        activeIndex = (activeIndex + 1) % cards.length;
        updateCoverflow();
      });
    }

    // Allow selecting cards directly by clicking them
    cards.forEach((card, idx) => {
      card.addEventListener('click', (e) => {
        if (idx !== activeIndex) {
          e.preventDefault();
          activeIndex = idx;
          updateCoverflow();
        }
      });
    });

    updateCoverflow();
    
    // Handle resizing dynamically
    window.addEventListener('resize', updateCoverflow);

    // Clean up timeout on transition away (Astro specific)
    document.addEventListener('astro:before-swap', () => {
      if (autoplayTimeout) clearTimeout(autoplayTimeout);
    });
  }

  // Execute initialization on page load and view transitions
  initCoverflow();
  document.addEventListener('astro:page-load', initCoverflow);
</script>
