---

import { useTranslations } from '../../i18n/utils';
import LocationCard from '../ui/LocationCard.astro';
import type { Locale } from '../../types/api';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section class="relative py-16 lg:py-24 bg-brand-cream-dark/60 border-t border-brand-gold/20">
  <!-- Wheat flakes pattern (real wheat stalk, normal scrolling) -->
  <div class="absolute inset-0 z-0 opacity-20 pointer-events-none mix-blend-multiply" style="background-image: url('/images/espiga-pattern.png'); background-size: 200px;"></div>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-12 space-y-3">
      <span class="text-xs uppercase tracking-widest font-bold text-brand-gold-secondary">
        📍 {t('home.locationSubtitle')}
      </span>
      <h2 class="font-serif text-3xl sm:text-4xl font-bold text-brand-brown">
        {t('home.locationTitle')}
      </h2>
    </div>

    <!-- Stacked Layout: 1. Contact & Info Card (Arriba) -> 2. Interactive Map Embed (Abajo) -->
    <div class="flex flex-col gap-8">
      
      <!-- TOP CARD: Hours, Location & Contact Details -->
      <LocationCard locale={locale} />

      <!-- BOTTOM CONTAINER: Interactive Google Maps Embed (Abajo) -->
      <div class="w-full bg-brand-cream rounded-3xl border-2 border-brand-gold/30 shadow-xl overflow-hidden h-[420px] sm:h-[480px] relative">
        <iframe
          title="Ubicación de Panadería El Trigal en Orange NJ"
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3021.54422833083!2d-74.231511!3d40.7720481!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x89c3ab663134e079%3A0x17530e951245c19f!2sPanaderia%20Y%20Pasteleria%20El%20Trigal!5e0!3m2!1sen!2sus!4v1785854235239!5m2!1sen!2sus"
          width="100%"
          height="100%"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="strict-origin-when-cross-origin"
        ></iframe>
      </div>

    </div>
  </div>
</section>
