---
import { SITE_CONFIG } from '../../config/site';
import { useTranslations } from '../../i18n/utils';
import CloudinaryImage from '../ui/CloudinaryImage.astro';
import DoorDashButton from '../ui/DoorDashButton.astro';
import UberEatsButton from '../ui/UberEatsButton.astro';
import CallButton from '../ui/CallButton.astro';
import type { Locale } from '../../types/api';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section class="relative bg-gradient-to-b from-brand-cream-dark via-brand-cream to-brand-cream pt-12 pb-32 lg:pt-20 lg:pb-48 overflow-hidden z-10">
  
  <!-- Subtle decorative background grain/circles and real wheat flakes (espigas) -->
  <div class="absolute inset-0 z-0 opacity-20 pointer-events-none mix-blend-multiply" style="background-image: url('/images/espiga-pattern.png'); background-size: 200px;"></div>
  <div class="absolute inset-0 opacity-40 pointer-events-none z-0">
    <div class="absolute top-10 left-1/2 -translate-x-1/2 w-[800px] h-[800px] rounded-full bg-brand-gold/10 blur-3xl"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Text Column -->
      <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
        
        <!-- Badge -->
        <div class="inline-flex items-center space-x-2 px-4 py-1.5 rounded-full bg-brand-brown text-brand-gold border border-brand-gold/40 text-xs sm:text-sm font-semibold tracking-wide shadow-sm">
          <span>🇪🇨</span>
          <span>{t('hero.badge')}</span>
        </div>

        <!-- Title -->
        <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-extrabold text-brand-brown leading-tight tracking-tight">
          {t('hero.title')}
        </h1>

        <!-- Subtitle -->
        <p class="text-lg sm:text-xl text-brand-brown/85 leading-relaxed max-w-2xl mx-auto lg:mx-0">
          {t('hero.subtitle')}
        </p>

        <!-- Feature Pills -->
        <div class="flex flex-wrap items-center justify-center lg:justify-start gap-3 pt-2 text-xs sm:text-sm font-semibold text-brand-brown">
          <div class="flex items-center space-x-1.5 bg-brand-gold/20 px-3 py-1.5 rounded-lg border border-brand-gold/30">
            <span class="text-brand-gold-secondary font-bold">✓</span>
            <span>{t('hero.feature1')}</span>
          </div>
          <div class="flex items-center space-x-1.5 bg-brand-gold/20 px-3 py-1.5 rounded-lg border border-brand-gold/30">
            <span class="text-brand-gold-secondary font-bold">✓</span>
            <span>{t('hero.feature2')}</span>
          </div>
          <div class="flex items-center space-x-1.5 bg-brand-gold/20 px-3 py-1.5 rounded-lg border border-brand-gold/30">
            <span class="text-brand-gold-secondary font-bold">✓</span>
            <span>{t('hero.feature3')}</span>
          </div>
        </div>

        <!-- CTAs & Direct Delivery Ordering -->
        <div class="flex flex-wrap items-center justify-center lg:justify-start gap-3 pt-4">
          <a
            href={locale === 'es' ? '/es/catalogo' : '/en/catalog'}
            class="px-6 py-3.5 rounded-full bg-brand-gold text-brand-brown font-bold text-sm hover:bg-brand-gold-secondary shadow-lg hover:shadow-gold-glow transition-all transform hover:-translate-y-0.5 text-center shrink-0"
          >
            {t('hero.ctaMenu')}
          </a>
          <DoorDashButton size="md" />
          <UberEatsButton size="md" />
        </div>

        <!-- Location quick tag -->
        <div class="pt-4 text-xs sm:text-sm text-brand-brown/70 flex items-center justify-center lg:justify-start space-x-2">
          <span>📍 {SITE_CONFIG.address.fullFormatted}</span>
          <span>•</span>
          <CallButton locale={locale} size="sm" class="ml-1" />
        </div>

      </div>

      <!-- Image / Media Column -->
      <div class="lg:col-span-5 relative">
        <div class="relative mx-auto max-w-md lg:max-w-none">
          <!-- Decorative frame -->
          <div class="absolute -inset-3 rounded-3xl bg-gradient-to-r from-brand-gold via-brand-gold-secondary to-brand-brown opacity-30 blur-lg"></div>
          
          <div class="relative rounded-3xl overflow-hidden shadow-2xl border-4 border-brand-gold">
            <CloudinaryImage
              src="https://images.unsplash.com/photo-1509440159596-0249088772ff?w=1000&auto=format&fit=crop&q=80"
              alt="Panadería El Trigal en Orange NJ - Pan fresco ambateño"
              width={800}
              height={900}
              priority={true}
              class="w-full h-[400px] sm:h-[480px] object-cover"
            />
            
            <!-- Floating Overlay Card -->
            <div class="absolute bottom-4 left-4 right-4 bg-brand-brown/90 backdrop-blur-md p-4 rounded-2xl border border-brand-gold/40 text-brand-cream">
              <div class="flex items-center space-x-3">
                <div class="w-10 h-10 rounded-full bg-brand-gold text-brand-brown flex items-center justify-center text-xl font-bold">
                  🌟
                </div>
                <div>
                  <h3 class="font-serif font-bold text-sm text-brand-gold">Pan ecuatoriano recién horneado</h3>
                  <p class="text-xs text-brand-cream/80">Tradición, frescura y sabor artesanal en Orange, NJ.</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- Curvy Bottom Wave Divider (Exact Replica of Reference Style) -->
  <div class="absolute bottom-0 left-0 w-full overflow-hidden leading-none z-0">
    <svg viewBox="0 0 1440 100" preserveAspectRatio="none" class="w-full h-[80px] md:h-[140px] block" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <!-- Gradient for the wave line -->
        <linearGradient id="wave-gradient" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="#D4AF37" />
          <stop offset="50%" stop-color="#4A3C31" />
          <stop offset="100%" stop-color="#D4AF37" />
        </linearGradient>
        <!-- Glow/Shadow effect -->
        <filter id="wave-glow" x="-20%" y="-20%" width="140%" height="140%">
          <feDropShadow dx="0" dy="4" stdDeviation="4" flood-color="#4A3C31" flood-opacity="0.3" />
        </filter>
      </defs>
      <!-- Cream Fill Base -->
      <path 
        d="M-5,50 C400,150 1000,-50 1445,50 L1445,105 L-5,105 Z" 
        fill="#FDFBF7">
      </path>
      <!-- Gradient Wave Stroke with Shadow -->
      <path 
        d="M-5,50 C400,150 1000,-50 1445,50" 
        fill="none" 
        stroke="url(#wave-gradient)" 
        stroke-width="14" 
        filter="url(#wave-glow)"
        vector-effect="non-scaling-stroke">
      </path>
    </svg>
  </div>
</section>
