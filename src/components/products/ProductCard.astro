---
import CloudinaryImage from '../ui/CloudinaryImage.astro';
import type { Locale } from '../../types/api';
import type { Product } from '../../types/product';
import { formatPriceCents } from '../../utils/formatters';

interface Props {
  product: Product;
  locale: Locale;
}

const { product, locale } = Astro.props;

const primaryImage = product.media.find((m) => m.isPrimary) || product.media[0];
const productUrl = locale === 'es'
  ? `/es/productos/${product.slug[locale] || product.slug.es}`
  : `/en/products/${product.slug[locale] || product.slug.en}`;

// Format price
const formattedPrice = product.priceLabel?.[locale]
  ? product.priceLabel[locale]
  : product.basePriceCents
  ? formatPriceCents(product.basePriceCents, locale)
  : null;

// Delivery availability
const hasDelivery = product.ordering?.deliveryEnabled || product.ordering?.onlineOrderingEnabled;
---

<article class="bg-brand-cream border border-brand-gold/30 rounded-2xl overflow-hidden shadow-warm hover:shadow-warm-hover transition-all duration-300 flex flex-col group h-full">
  
  <!-- Image Container -->
  <a href={productUrl} class="relative block overflow-hidden aspect-[4/3] bg-brand-cream-dark">
    {
      primaryImage ? (
        <CloudinaryImage
          src={primaryImage.secureUrl}
          alt={primaryImage.altText[locale] || product.name[locale]}
          width={600}
          height={450}
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        />
      ) : (
        <div class="w-full h-full flex items-center justify-center text-4xl text-brand-gold-secondary">
          🍞
        </div>
      )
    }
    <!-- Delivery badge overlay -->
    {
      hasDelivery && (
        <span class="absolute top-2.5 right-2.5 bg-brand-brown/90 text-brand-gold text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full backdrop-blur-sm">
          🚚 {locale === 'es' ? 'Delivery' : 'Delivery'}
        </span>
      )
    }
  </a>

  <!-- Content -->
  <div class="p-5 flex flex-col flex-grow space-y-2">
    <div class="text-xs font-semibold text-brand-gold-secondary uppercase tracking-wider">
      {product.primaryCategory.name[locale]}
    </div>
    <h3 class="font-serif font-bold text-xl text-brand-brown group-hover:text-brand-brown-dark transition-colors line-clamp-1">
      <a href={productUrl} class="focus:outline-none focus:underline">
        {product.name[locale]}
      </a>
    </h3>
    <p class="text-xs sm:text-sm text-brand-brown/75 line-clamp-2 leading-relaxed flex-grow">
      {product.shortDescription[locale]}
    </p>

    <!-- Price Row -->
    <div class="pt-2 flex items-center justify-between border-t border-brand-gold/20">
      {
        formattedPrice ? (
          <span class="font-serif font-extrabold text-xl text-brand-brown">{formattedPrice}</span>
        ) : (
          <span class="text-xs text-brand-brown/50 italic">{locale === 'es' ? 'Consultar precio' : 'Ask for price'}</span>
        )
      }
      <a
        href={productUrl}
        class="text-xs font-bold text-brand-brown/60 hover:text-brand-brown underline-offset-2 hover:underline transition-colors"
      >
        {locale === 'es' ? 'Ver más →' : 'View →'}
      </a>
    </div>
  </div>

</article>
