---
import BaseLayout from '../../../components/layout/BaseLayout.astro';
import Breadcrumbs from '../../../components/ui/Breadcrumbs.astro';
import ProductCard from '../../../components/products/ProductCard.astro';
import { getCategoryBySlug, getProducts } from '../../../services/api/publicApi';
import { useTranslations } from '../../../i18n/utils';

export const prerender = false;

const locale = 'en';
const t = useTranslations(locale);
const { categorySlug } = Astro.params;

const category = await getCategoryBySlug(categorySlug || '', locale);

if (category && category.slug.en && categorySlug !== category.slug.en) {
  return Astro.redirect(`/en/menu/${category.slug.en}`);
}

const { products } = await getProducts({ locale, categorySlug: category?.slug.en || categorySlug || '' });

const breadcrumbs = [
  { name: t('nav.home'), url: '/en/' },
  { name: t('nav.menu'), url: '/en/menu' },
  { name: category?.name[locale] || categorySlug || '', url: `/en/menu/${categorySlug}` },
];
---

<BaseLayout
  title={category?.name[locale] || 'Category Menu'}
  description={category?.description?.[locale] || 'Bakery and pastry catalog at El Trigal in Orange, NJ.'}
  locale={locale}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <Breadcrumbs items={breadcrumbs} locale={locale} />

    <div class="mb-10 space-y-3">
      <h1 class="font-serif text-3xl sm:text-5xl font-extrabold text-brand-brown">
        {category?.name[locale] || categorySlug}
      </h1>
      {
        category?.description && (
          <p class="text-brand-brown/80 text-base sm:text-lg max-w-3xl">
            {category.description[locale]}
          </p>
        )
      }
    </div>

    {
      products.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
          {products.map((product) => (
            <ProductCard product={product} locale={locale} />
          ))}
        </div>
      ) : (
        <div class="text-center py-16 bg-brand-cream-dark/30 rounded-3xl border border-dashed border-brand-brown/30 space-y-4">
          <div class="text-5xl">🥖</div>
          <h3 class="font-serif text-2xl font-bold text-brand-brown">{t('menu.noResultsTitle')}</h3>
          <a href="/en/menu" class="inline-block px-6 py-2.5 rounded-full bg-brand-gold text-brand-brown font-bold text-xs">
            {t('common.backToMenu')}
          </a>
        </div>
      )
    }
  </div>
</BaseLayout>
