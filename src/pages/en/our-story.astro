---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import CloudinaryImage from '../../components/ui/CloudinaryImage.astro';

const locale = 'en';
const breadcrumbs = [
  { name: 'Home', url: '/en/' },
  { name: 'Our Story', url: '/en/our-story' },
];
---

<BaseLayout
  title="Our Story & Ambato Baking Heritage"
  description="Discover the story of El Trigal Bakery in Orange, NJ: Ambato baking tradition brought to the heart of New Jersey."
  locale={locale}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <Breadcrumbs items={breadcrumbs} locale={locale} />

    <div class="max-w-4xl mx-auto space-y-10">
      <div class="text-center space-y-4">
        <span class="text-xs uppercase tracking-widest font-bold text-brand-gold-secondary">
          🌾 Pride & Heritage of Ambato
        </span>
        <h1 class="font-serif text-4xl sm:text-5xl font-extrabold text-brand-brown">
          The Story Behind El Trigal
        </h1>
      </div>

      <div class="rounded-3xl overflow-hidden shadow-2xl border-4 border-brand-gold">
        <CloudinaryImage
          src="/images/pan-dulce-tradicional-ecuatoriano-el-trigal.jpg"
          alt="El Trigal Bakery history in Orange NJ"
          width={1000}
          height={600}
          class="w-full h-[400px] object-cover"
        />
      </div>

      <div class="prose prose-lg max-w-none text-brand-brown/85 leading-relaxed space-y-6">
        <p>
          Ambato is known worldwide as the <em>"Land of Flowers and Fruits"</em>, but for anyone who has walked its streets, Ambato is above all the home of Ecuador's finest bread. The aroma of freshly baked dough in the early morning is part of Ambato's soul.
        </p>
        <p>
          When moving to New Jersey, our family felt a deep calling to keep that culinary tradition alive. That is how <strong>El Trigal Bakery</strong> was born in Orange, NJ. From day one, our mission was clear: deliver the exact authentic taste of fresh bread from our homeland to both Latin and American communities.
        </p>
        <p>
          Our recipes are 100% artisanal, honoring ancestral methods: flaky hand-rolled allullas, crispy crust pan de agua, puffed wind empanadas filled with melted cheese, and quesadillas crafted with achira starch.
        </p>
      </div>
    </div>
  </div>
</BaseLayout>
