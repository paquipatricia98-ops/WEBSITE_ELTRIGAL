---
import BaseLayout from '../../../components/layout/BaseLayout.astro';
import Breadcrumbs from '../../../components/ui/Breadcrumbs.astro';
import { getCategories } from '../../../services/api/publicApi';
import { useTranslations } from '../../../i18n/utils';

const locale = 'en';
const t = useTranslations(locale);

const breadcrumbs = [
  { name: t('nav.home'), url: '/en/' },
  { name: 'Catalog', url: '/en/catalog' },
];

const categories = await getCategories({ locale, type: 'local' });

function getCategoryIcon(name: string, slug: string): string {
  const n = (name || '').toLowerCase();
  const s = (slug || '').toLowerCase();
  
  if (s.includes('pan') || n.includes('pan')) return '🥐';
  if (s.includes('pastel') || n.includes('pastel') || s.includes('cake') || n.includes('cake')) return '🎂';
  if (s.includes('postre') || n.includes('postre') || s.includes('dulce') || n.includes('sweet') || s.includes('dessert') || n.includes('dessert')) return '🧁';
  if (s.includes('bocadito') || n.includes('bocadito') || s.includes('snack') || n.includes('snack') || s.includes('fiesta') || n.includes('party')) return '🍢';
  if (s.includes('paisaje') || n.includes('paisaje') || s.includes('land') || n.includes('land')) return '🖼️';
  if (s.includes('kitty') || n.includes('kitty') || s.includes('kity') || n.includes('kity')) return '🐱';
  if (s.includes('lacteo') || n.includes('lácteo') || s.includes('cheese') || n.includes('queso') || s.includes('dairy')) return '🧀';
  if (s.includes('bebida') || n.includes('bebida') || s.includes('drink') || n.includes('drink') || s.includes('caf') || n.includes('caf')) return '🥤';
  if (s.includes('personalizado') || n.includes('personalizado') || s.includes('custom') || n.includes('custom')) return '🎨';
  
  return '🍰';
}
---

<BaseLayout
  title="Artisanal Product Catalog"
  description="Explore our local artisanal product catalog made fresh in the USA, custom cakes, and specialties."
  locale={locale}
>
  <div class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-10">
    
    <div id="catalog-breadcrumbs">
      <Breadcrumbs items={breadcrumbs} locale={locale} />
    </div>

    <!-- PAGE HEADER -->
    <div id="catalog-page-header" class="text-center space-y-3 max-w-3xl mx-auto">
      <span class="text-xs uppercase tracking-widest font-bold text-brand-gold-secondary">
        🥐 Fresh Local Flavors
      </span>
      <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-extrabold text-brand-brown">
        Product Catalog
      </h1>
      <p class="text-brand-brown/85 text-base sm:text-lg">
        Discover our variety of handcrafted products made fresh daily using premium ingredients.
      </p>
    </div>

    <!-- SEARCH & CATEGORY FILTER CONTROL BAR -->
    {categories.length > 0 && (
      <div id="catalog-filter-bar" class="w-full bg-[#fdfdfb]/90 p-6 md:p-8 rounded-[24px] border border-brand-gold/40 shadow-sm space-y-6">
        
        <!-- Real-Time Search Bar -->
        <div class="relative w-full max-w-xl mx-auto">
          <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-brand-gold-secondary">
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
            </svg>
          </div>
          <input
            type="text"
            id="product-search-input"
            class="w-full pl-12 pr-10 py-3 rounded-full bg-[#FAF7F2] border border-brand-gold/35 text-brand-brown font-semibold placeholder:text-brand-brown/40 focus:outline-none focus:ring-2 focus:ring-brand-gold/50 focus:border-brand-gold/50 transition-all text-sm shadow-inner"
            placeholder="Search breads, cakes, desserts, empanadas, party snacks..."
          />
          <button
            type="button"
            id="clear-search-btn"
            class="hidden absolute inset-y-0 right-0 pr-4 flex items-center text-brand-brown/60 hover:text-brand-brown"
            aria-label="Clear search"
          >
            ✕
          </button>
        </div>

        <!-- Category Filter Pills (Centered with Dynamic Icons and Rounded Full) -->
        <div class="flex flex-wrap items-center justify-center gap-3.5 pt-5 border-t border-brand-gold/15" id="category-pills-container">
          <button
            type="button"
            data-category="todas"
            class="category-pill px-5 py-2.5 rounded-full text-xs sm:text-sm font-bold transition-all border shadow-xs flex items-center space-x-1.5 cursor-pointer bg-brand-brown text-brand-gold border-brand-gold active-pill"
          >
            <span>✨</span>
            <span>All Categories</span>
          </button>
          {categories.map((c: any) => {
            const icon = getCategoryIcon(c.name[locale] || c.name.en || c.name.es, c.slug?.[locale] || c.id);
            return (
              <button
                type="button"
                data-category={c.slug?.[locale] || c.id}
                class="category-pill px-5 py-2.5 rounded-full text-xs sm:text-sm font-bold transition-all border shadow-xs flex items-center space-x-1.5 cursor-pointer bg-[#FAF7F2] text-brand-brown border-brand-gold/25 hover:bg-brand-gold/10"
              >
                <span>{icon}</span>
                <span>{c.name[locale] || c.name.en || c.name.es}</span>
              </button>
            );
          })}
        </div>
      </div>
    )}

    <!-- CATALOG CATEGORIES LIST -->
    {categories.length > 0 ? (
      <div class="space-y-16" id="catalog-sections-container">
        {categories.map((cat: any) => (
          <section 
            class="category-section break-inside-avoid mb-8 bg-brand-cream border-2 border-brand-gold/30 rounded-3xl p-6 sm:p-8 shadow-xl space-y-6"
            data-category={cat.slug?.[locale] || cat.id}
          >
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-brand-gold/20 pb-4">
              <div>
                <h2 class="font-serif text-lg sm:text-xl md:text-2xl font-bold text-brand-brown flex flex-wrap items-center gap-2">
                  <span>{getCategoryIcon(cat.name[locale] || cat.name.en || cat.name.es, cat.slug?.[locale] || cat.id)}</span>
                  <span>{cat.name[locale] || cat.name.en || cat.name.es}</span>
                  {cat.featured && (
                    <span class="flex-shrink-0 whitespace-nowrap text-[10px] sm:text-xs bg-brand-gold text-brand-brown font-extrabold px-2.5 py-0.5 rounded-full shadow-sm">
                      ⭐ Featured
                    </span>
                  )}
                </h2>
                {cat.description && (cat.description[locale] || cat.description.en || cat.description.es) && (
                  <p class="category-desc-block text-xs sm:text-sm text-brand-brown/80 mt-1 max-w-3xl">
                    <span class="desc-truncated line-clamp-1">{cat.description[locale] || cat.description.en || cat.description.es}</span>
                    <span class="desc-full hidden">{cat.description[locale] || cat.description.en || cat.description.es}</span>
                    {(cat.description[locale] || cat.description.en || cat.description.es).length > 60 && (
                      <button type="button" class="btn-toggle-desc text-xs text-brand-gold-secondary font-bold hover:underline ml-1 inline-block cursor-pointer">
                        Read more
                      </button>
                    )}
                  </p>
                )}
              </div>

              <div class="flex flex-wrap items-center gap-3 sm:justify-end">
                <!-- Share Category Button -->
                <button 
                  class="share-category-btn inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl border border-brand-gold bg-[#fdfdfb] text-brand-brown font-extrabold text-xs shadow-xs hover:bg-brand-gold/15 transition-all cursor-pointer"
                  data-category-slug={cat.slug?.[locale] || cat.id}
                  data-category-name={cat.name[locale] || cat.name.en || cat.name.es}
                >
                  <svg class="w-3.5 h-3.5 fill-current text-brand-gold-secondary" viewBox="0 0 24 24">
                    <path d="M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81 1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3c0 .24.04.47.09.7L8.04 9.81C7.5 9.31 6.79 9 6 9c-1.66 0-3 1.34-3 3s1.34 3 3 3c.79 0 1.5-.31 2.04-.81l7.12 4.16c-.05.21-.08.43-.08.65 0 1.61 1.31 2.92 2.92 2.92s2.92-1.31 2.92-2.92c0-1.61-1.31-2.92-2.92-2.92z"/>
                  </svg>
                  <span>Share</span>
                </button>

                <!-- Allergens Badges -->
                {cat.allergens && cat.allergens.length > 0 && (
                  <div class="flex flex-wrap items-center gap-1.5">
                    <span class="text-xs font-semibold text-brand-brown/60">Allergens:</span>
                    {cat.allergens.map((allergen: string) => (
                      <span class="text-xs font-bold bg-amber-100 text-amber-900 border border-amber-300 px-2 py-0.5 rounded-md uppercase tracking-wider">
                        ⚠️ {allergen}
                      </span>
                    ))}
                  </div>
                )}
              </div>
            </div>

            <!-- Photos Gallery Grid (Responsive Flex items starting centered) -->
            {cat.images && cat.images.length > 0 ? (
              <div class="flex flex-wrap justify-center gap-5 items-start">
                {cat.images.map((img: any) => (
                  <div 
                    class="product-gallery-item w-[120px] sm:w-[150px] md:w-[180px] mb-5 relative overflow-hidden rounded-[24px] border border-brand-gold/30 bg-white p-2 shadow-sm hover:shadow-md hover:scale-[1.02] transition-all duration-300 cursor-pointer"
                    data-search={(img.alt || cat.name[locale] || cat.name.es).toLowerCase()}
                  >
                    <img
                      src={img.url}
                      alt={img.alt || cat.name.es}
                      class="w-full h-auto object-cover rounded-[18px]"
                      loading="lazy"
                    />
                  </div>
                ))}
              </div>
            ) : (
              <div class="text-center py-8 text-brand-brown/50 text-sm italic">
                Coming soon images for this category.
              </div>
            )}

            <!-- VIEW FULL CATALOG OPTION INSIDE EACH CATALOG BLOCK (Visible only in shared view mode) -->
            <div class="shared-view-footer-block hidden pt-6 text-center border-t border-brand-gold/15 mt-8">
              <button 
                type="button"
                class="btn-view-full-catalog-action inline-flex items-center gap-2 px-6 py-3 rounded-full border-2 border-brand-gold bg-[#fdfdfb] text-brand-brown font-extrabold text-sm shadow hover:bg-brand-gold hover:text-brand-brown transition-all cursor-pointer"
              >
                <span>View Full Catalog</span>
              </button>
            </div>
          </section>
        ))}
      </div>
    ) : (
      <div class="text-center py-16 bg-brand-cream rounded-3xl border-2 border-dashed border-brand-gold/40 p-8 space-y-4">
        <div class="text-4xl">🧁</div>
        <h3 class="font-serif text-xl font-bold text-brand-brown">Catalog Updating</h3>
        <p class="text-sm text-brand-brown/70 max-w-md mx-auto">
          We are adding new delicacies to our local catalog. Come back soon!
        </p>
      </div>
    )}

    <!-- NO RESULTS EMPTY STATE -->
    <div id="no-results-state" class="hidden text-center py-16 bg-brand-cream rounded-3xl border-2 border-dashed border-brand-gold/40 p-8 space-y-4">
      <div class="text-4xl">🔍</div>
      <h3 class="font-serif text-xl font-bold text-brand-brown">No products match your search</h3>
      <p class="text-xs sm:text-sm text-brand-brown/70 max-w-md mx-auto">
        Try searching for another term or click on "All Categories" to see the full catalog.
      </p>
    </div>
    <!-- Lightbox Modal Container -->
    <div 
      id="image-lightbox" 
      class="fixed inset-0 z-50 hidden items-center justify-center bg-black/95 backdrop-blur-md transition-opacity duration-300 opacity-0"
      role="dialog"
      aria-modal="true"
    >
      <!-- Close Button -->
      <button 
        id="lightbox-close" 
        class="absolute top-5 right-5 z-52 text-white/70 hover:text-white bg-white/10 hover:bg-white/20 p-3 rounded-full transition-all duration-200 cursor-pointer"
        aria-label="Close gallery"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

      <!-- Navigation Buttons -->
      <button 
        id="lightbox-prev" 
        class="absolute left-4 z-52 text-white/70 hover:text-white bg-white/10 hover:bg-white/20 p-3 rounded-full transition-all duration-200 cursor-pointer select-none"
        aria-label="Previous image"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
      </button>

      <button 
        id="lightbox-next" 
        class="absolute right-4 z-52 text-white/70 hover:text-white bg-white/10 hover:bg-white/20 p-3 rounded-full transition-all duration-200 cursor-pointer select-none"
        aria-label="Next image"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </button>

      <!-- Main Content Frame -->
      <div class="relative max-w-5xl max-h-[85vh] px-4 flex flex-col items-center justify-center">
        <img 
          id="lightbox-img" 
          src="" 
          alt="" 
          class="max-w-full max-h-[75vh] object-contain rounded-2xl shadow-2xl transition-all duration-300 scale-95 opacity-0"
        />
        <!-- Caption / Title & Counter -->
        <div class="mt-4 text-center text-white/80 space-y-1">
          <p id="lightbox-caption" class="text-sm font-medium tracking-wide"></p>
          <p id="lightbox-counter" class="text-xs text-white/50 font-bold uppercase tracking-wider"></p>
        </div>
      </div>
    </div>
  </div>

  <!-- Real-Time Client-Side Filtering Script -->
  <script>
    let handleKeyDownGlobal: ((e: KeyboardEvent) => void) | null = null;

    function initCatalog() {
      const searchInput = document.getElementById('product-search-input') as HTMLInputElement | null;
      const clearBtn = document.getElementById('clear-search-btn');
      const pills = document.querySelectorAll<HTMLButtonElement>('.category-pill');
      const sections = document.querySelectorAll<HTMLElement>('.category-section');
      const noResults = document.getElementById('no-results-state');

      const catalogBreadcrumbs = document.getElementById('catalog-breadcrumbs');
      const catalogPageHeader = document.getElementById('catalog-page-header');
      const catalogFilterBar = document.getElementById('catalog-filter-bar');
      const catalogSectionsContainer = document.getElementById('catalog-sections-container');

      let activeCategory = 'todas';
      let isSharedViewMode = false;

      const filterCatalog = () => {
        const query = (searchInput?.value || '').trim().toLowerCase();
        let totalVisibleSections = 0;

        if (clearBtn) {
          clearBtn.classList.toggle('hidden', query.length === 0);
        }

        // Hide or show website headers based on Shared View Mode
        if (isSharedViewMode) {
          catalogBreadcrumbs?.classList.add('hidden');
          catalogPageHeader?.classList.add('hidden');
          catalogFilterBar?.classList.add('hidden');
        } else {
          catalogBreadcrumbs?.classList.remove('hidden');
          catalogPageHeader?.classList.remove('hidden');
          catalogFilterBar?.classList.remove('hidden');
        }

        // Toggle category side-by-side layout (columns-1 lg:columns-2 gap-8) based on activeCategory & isSharedViewMode
        if (activeCategory === 'todas' && !isSharedViewMode) {
          catalogSectionsContainer?.classList.remove('space-y-16');
          catalogSectionsContainer?.classList.add('columns-1', 'lg:columns-2', 'gap-8');
        } else {
          catalogSectionsContainer?.classList.remove('columns-1', 'lg:columns-2', 'gap-8');
          catalogSectionsContainer?.classList.add('space-y-16');
        }

        sections.forEach((section) => {
          const catId = section.getAttribute('data-category') || '';
          const matchesCat = activeCategory === 'todas' || catId === activeCategory;
          const footerBlock = section.querySelector('.shared-view-footer-block');

          if (!matchesCat) {
            section.classList.add('hidden');
            footerBlock?.classList.add('hidden');
            return;
          }

          // Show/hide section footer back button based on shared view mode
          if (isSharedViewMode) {
            footerBlock?.classList.remove('hidden');
          } else {
            footerBlock?.classList.add('hidden');
          }

          // Filter individual items inside this section
          const items = section.querySelectorAll<HTMLElement>('.product-gallery-item');
          let visibleItemsCount = 0;

          items.forEach((item) => {
            const itemSearchText = item.getAttribute('data-search') || '';
            const matchesQuery = query === '' || itemSearchText.includes(query);

            if (matchesQuery) {
              item.classList.remove('hidden');
              visibleItemsCount++;
            } else {
              item.classList.add('hidden');
            }
          });

          // Hide section if no items match query
          if (visibleItemsCount > 0 || (items.length === 0 && query === '')) {
            section.classList.remove('hidden');
            totalVisibleSections++;
          } else {
            section.classList.add('hidden');
          }
        });

        if (noResults) {
          noResults.classList.toggle('hidden', totalVisibleSections > 0);
        }
      };

      // Category Pill Click Handler
      pills.forEach((pill) => {
        pill.addEventListener('click', () => {
          const cat = pill.getAttribute('data-category') || 'todas';
          activeCategory = cat;
          isSharedViewMode = false; // Normal browsing mode

          pills.forEach((p) => {
            if (p.getAttribute('data-category') === cat) {
              p.className = 'category-pill px-5 py-2.5 rounded-full text-xs sm:text-sm font-bold transition-all border shadow-xs flex items-center space-x-1.5 cursor-pointer bg-brand-brown text-brand-gold border-brand-gold active-pill';
            } else {
              p.className = 'category-pill px-5 py-2.5 rounded-full text-xs sm:text-sm font-bold transition-all border shadow-xs flex items-center space-x-1.5 cursor-pointer bg-[#FAF7F2] text-brand-brown border-brand-gold/25 hover:bg-brand-gold/10';
            }
          });

          // Update URL query parameters dynamically
          if (cat === 'todas') {
            const cleanUrl = window.location.protocol + "//" + window.location.host + window.location.pathname;
            window.history.pushState({ path: cleanUrl }, '', cleanUrl);
          } else {
            const cleanUrl = window.location.protocol + "//" + window.location.host + window.location.pathname + '?category=' + cat;
            window.history.pushState({ path: cleanUrl }, '', cleanUrl);
          }

          filterCatalog();
        });
      });

      // Search Input Event
      if (searchInput) {
        searchInput.addEventListener('input', filterCatalog);
      }

      // Clear Search Event
      if (clearBtn) {
        clearBtn.addEventListener('click', () => {
          if (searchInput) {
            searchInput.value = '';
            filterCatalog();
          }
        });
      }

      // View Full Catalog Event inside each shared section block
      const viewFullCatalogBtns = document.querySelectorAll('.btn-view-full-catalog-action');
      viewFullCatalogBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          isSharedViewMode = false;
          activeCategory = 'todas';
          if (searchInput) searchInput.value = '';

          pills.forEach((p) => {
            const cat = p.getAttribute('data-category');
            if (cat === 'todas') {
              p.className = 'category-pill px-5 py-2.5 rounded-full text-xs sm:text-sm font-bold transition-all border shadow-xs flex items-center space-x-1.5 cursor-pointer bg-brand-brown text-brand-gold border-brand-gold active-pill';
            } else {
              p.className = 'category-pill px-5 py-2.5 rounded-full text-xs sm:text-sm font-bold transition-all border shadow-xs flex items-center space-x-1.5 cursor-pointer bg-[#FAF7F2] text-brand-brown border-brand-gold/25 hover:bg-brand-gold/10';
            }
          });

          // Clear query parameters from URL gracefully without reload
          const cleanUrl = window.location.protocol + "//" + window.location.host + window.location.pathname;
          window.history.pushState({ path: cleanUrl }, '', cleanUrl);

          filterCatalog();
        });
      });

      // Share Category Button Event
      const shareBtns = document.querySelectorAll<HTMLButtonElement>('.share-category-btn');
      shareBtns.forEach((btn) => {
        btn.addEventListener('click', async (e) => {
          e.stopPropagation(); // Avoid triggering any section actions
          const slug = btn.getAttribute('data-category-slug') || '';
          const catName = btn.getAttribute('data-category-name') || '';
          const shareUrl = `${window.location.origin}${window.location.pathname}?category=${slug}`;
          
          const labelSpan = btn.querySelector('span');
          const originalText = labelSpan ? labelSpan.textContent : 'Share';

          // 1. Update shared view states immediately
          activeCategory = slug;
          isSharedViewMode = true;

          // 2. Sync browser URL bar so the user sees the shared parameter immediately
          window.history.pushState({ path: shareUrl }, '', shareUrl);

          // 3. Highlight the correct pill corresponding to this shared category
          pills.forEach((p) => {
            if (p.getAttribute('data-category') === slug) {
              p.className = 'category-pill px-5 py-2.5 rounded-full text-xs sm:text-sm font-bold transition-all border shadow-xs flex items-center space-x-1.5 cursor-pointer bg-brand-brown text-brand-gold border-brand-gold active-pill';
            } else {
              p.className = 'category-pill px-5 py-2.5 rounded-full text-xs sm:text-sm font-bold transition-all border shadow-xs flex items-center space-x-1.5 cursor-pointer bg-[#FAF7F2] text-brand-brown border-brand-gold/25 hover:bg-brand-gold/10';
            }
          });

          // 4. Trigger the UI layout filter immediately (hiding headers and only showing this category)
          filterCatalog();

          // 5. Native/clipboard sharing (Only share the URL to avoid concatenation bugs in macOS share sheet)
          const shareData = {
            title: `El Trigal - ${catName}`,
            url: shareUrl
          };

          try {
            if (navigator.share) {
              await navigator.share(shareData);
            } else {
              await navigator.clipboard.writeText(shareUrl);
              if (labelSpan) {
                labelSpan.textContent = 'Copied! 📋';
                setTimeout(() => { labelSpan.textContent = originalText; }, 2000);
              }
            }
          } catch (err) {
            try {
              await navigator.clipboard.writeText(shareUrl);
              if (labelSpan) {
                labelSpan.textContent = 'Copied! 📋';
                setTimeout(() => { labelSpan.textContent = originalText; }, 2000);
              }
            } catch (e) {}
          }
        });
      });

      // Toggle Category description read more/less
      const descTogglers = document.querySelectorAll('.btn-toggle-desc');
      descTogglers.forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const parent = btn.closest('.category-desc-block');
          if (parent) {
            const truncated = parent.querySelector('.desc-truncated');
            const full = parent.querySelector('.desc-full');
            const isTruncatedHidden = truncated?.classList.contains('hidden');

            if (isTruncatedHidden) {
              truncated?.classList.remove('hidden');
              full?.classList.add('hidden');
              btn.textContent = 'Read more';
            } else {
              truncated?.classList.add('hidden');
              full?.classList.remove('hidden');
              btn.textContent = 'Read less';
            }
          }
        });
      });

      // Read URL query parameters on load to trigger deep linked category view
      const urlParams = new URLSearchParams(window.location.search);
      let categoryParam = urlParams.get('category');
      if (categoryParam) {
        // Sanitize category parameter to extract only the slug in case text was appended in clipboard
        categoryParam = categoryParam.trim().split(' ')[0];
        activeCategory = categoryParam;
        isSharedViewMode = true; // Enable Shared View Mode on page load
        pills.forEach((p) => {
          if (p.getAttribute('data-category') === categoryParam) {
            p.className = 'category-pill px-5 py-2.5 rounded-full text-xs sm:text-sm font-bold transition-all border shadow-xs flex items-center space-x-1.5 cursor-pointer bg-brand-brown text-brand-gold border-brand-gold active-pill';
          } else {
            p.className = 'category-pill px-5 py-2.5 rounded-full text-xs sm:text-sm font-bold transition-all border shadow-xs flex items-center space-x-1.5 cursor-pointer bg-[#FAF7F2] text-brand-brown border-brand-gold/25 hover:bg-brand-gold/10';
          }
        });
      }

      // LIGHTBOX IMAGE GALLERY
      const lightbox = document.getElementById('image-lightbox');
      const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
      const lightboxCaption = document.getElementById('lightbox-caption');
      const lightboxCounter = document.getElementById('lightbox-counter');
      const closeBtn = document.getElementById('lightbox-close');
      const prevBtn = document.getElementById('lightbox-prev');
      const nextBtn = document.getElementById('lightbox-next');

      let currentGalleryItems: HTMLElement[] = [];
      let currentActiveIndex = 0;

      const openLightbox = (item: HTMLElement) => {
        const parentSection = item.closest('.category-section');
        if (!parentSection) return;

        // Gather all visible items in the same section/category
        currentGalleryItems = Array.from(parentSection.querySelectorAll<HTMLElement>('.product-gallery-item:not(.hidden)'));
        currentActiveIndex = currentGalleryItems.indexOf(item);

        updateLightboxContent();

        if (lightbox) {
          lightbox.classList.remove('hidden');
          lightbox.classList.add('flex');
          // Add opacity transition classes
          setTimeout(() => {
            lightbox.classList.remove('opacity-0');
          }, 50);
        }
      };

      const updateLightboxContent = () => {
        if (currentGalleryItems.length === 0 || !lightboxImg) return;
        const activeItem = currentGalleryItems[currentActiveIndex];
        const imgEl = activeItem.querySelector('img');
        if (!imgEl) return;

        // Smooth transition effect
        lightboxImg.classList.remove('scale-100', 'opacity-100');
        lightboxImg.classList.add('scale-95', 'opacity-0');

        setTimeout(() => {
          lightboxImg.src = imgEl.src;
          lightboxImg.alt = imgEl.alt;
          if (lightboxCaption) {
            lightboxCaption.textContent = imgEl.alt || '';
          }
          if (lightboxCounter) {
            lightboxCounter.textContent = `Image ${currentActiveIndex + 1} of ${currentGalleryItems.length}`;
          }

          if (currentGalleryItems.length <= 1) {
            if (prevBtn) prevBtn.classList.add('hidden');
            if (nextBtn) nextBtn.classList.add('hidden');
          } else {
            if (prevBtn) prevBtn.classList.remove('hidden');
            if (nextBtn) nextBtn.classList.remove('hidden');
          }
          
          lightboxImg.classList.remove('scale-95', 'opacity-0');
          lightboxImg.classList.add('scale-100', 'opacity-100');
        }, 150);
      };

      const closeLightbox = () => {
        if (lightbox) {
          lightbox.classList.add('opacity-0');
          if (lightboxImg) {
            lightboxImg.classList.remove('scale-100', 'opacity-100');
            lightboxImg.classList.add('scale-95', 'opacity-0');
          }
          setTimeout(() => {
            lightbox.classList.add('hidden');
            lightbox.classList.remove('flex');
          }, 300);
        }
      };

      const showNext = () => {
        if (currentGalleryItems.length === 0) return;
        currentActiveIndex = (currentActiveIndex + 1) % currentGalleryItems.length;
        updateLightboxContent();
      };

      const showPrev = () => {
        if (currentGalleryItems.length === 0) return;
        currentActiveIndex = (currentActiveIndex - 1 + currentGalleryItems.length) % currentGalleryItems.length;
        updateLightboxContent();
      };

      // Bind click to visible gallery items
      document.querySelectorAll<HTMLElement>('.product-gallery-item').forEach((item) => {
        item.addEventListener('click', () => {
          openLightbox(item);
        });
      });

      // Bind control buttons
      if (closeBtn) closeBtn.addEventListener('click', closeLightbox);
      if (nextBtn) nextBtn.addEventListener('click', showNext);
      if (prevBtn) prevBtn.addEventListener('click', showPrev);

      // Close when clicking overlay background (outside image and buttons)
      if (lightbox) {
        lightbox.addEventListener('click', (e) => {
          if (e.target === lightbox) {
            closeLightbox();
          }
        });
      }

      // Keyboard support
      if (handleKeyDownGlobal) {
        window.removeEventListener('keydown', handleKeyDownGlobal);
      }
      handleKeyDownGlobal = (e: KeyboardEvent) => {
        if (!lightbox || lightbox.classList.contains('hidden')) return;
        if (e.key === 'ArrowRight') showNext();
        if (e.key === 'ArrowLeft') showPrev();
        if (e.key === 'Escape') closeLightbox();
      };
      window.addEventListener('keydown', handleKeyDownGlobal);

      filterCatalog();
    }

    // Bind to both page load and transition events (Astro View Transitions support)
    document.addEventListener('DOMContentLoaded', initCatalog);
    document.addEventListener('astro:page-load', initCatalog);
  </script>
</BaseLayout>
