---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import CustomCakeForm from '../../components/forms/CustomCakeForm.astro';
import CakeProcessSteps from '../../components/home/CakeProcessSteps.astro';


const locale = 'es';
const breadcrumbs = [
  { name: 'Inicio', url: '/es/' },
  { name: 'Pasteles Personalizados', url: '/es/pasteles-personalizados' },
];
---

<BaseLayout
  title="Pasteles Personalizados para Bodas y Cumpleaños en Orange, NJ"
  description="Cotiza tu pastel personalizado en Orange, NJ. Pasteles de tres leches, fondant, merengue italiano para bautizos, bodas y fiestas."
  locale={locale}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <Breadcrumbs items={breadcrumbs} locale={locale} />

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center mb-16">
      <div class="lg:col-span-6 space-y-6">
        <span class="text-xs font-bold uppercase tracking-widest text-brand-gold-secondary">
          🎂 Alta Pastelería Artesanal
        </span>
        <h1 class="font-serif text-4xl sm:text-5xl font-extrabold text-brand-brown leading-tight">
          Pasteles Diseñados Exclusivamente para tu Celebración
        </h1>
        <p class="text-brand-brown/85 text-base sm:text-lg leading-relaxed">
          En El Trigal convertimos tus ideas en obras de arte comestibles. Preparamos bizcochos húmedos de tres leches, maracuyá, chocolate o vainilla fina con los rellenos y decoraciones que sueñas.
        </p>
        <div class="flex flex-wrap gap-3 text-xs font-bold text-brand-brown">
          <span class="px-3 py-1.5 rounded-lg bg-brand-gold/20 border border-brand-gold/40">✨ Bodas y Quinceañeras</span>
          <span class="px-3 py-1.5 rounded-lg bg-brand-gold/20 border border-brand-gold/40">✨ Bautizos y Comuniones</span>
          <span class="px-3 py-1.5 rounded-lg bg-brand-gold/20 border border-brand-gold/40">✨ Cumpleaños Infantiles</span>
        </div>
      </div>

      <div class="lg:col-span-6">
        <div class="rounded-3xl overflow-hidden shadow-2xl border-4 border-brand-gold">
          <img
            src="/images/hero-cake.png"
            alt="Pastel personalizado artesanal El Trigal"
            class="w-full h-[400px] object-cover"
          />
        </div>
      </div>
    </div>

    <CakeProcessSteps locale={locale} />

    <div class="mt-16">
      <CustomCakeForm locale={locale} />
    </div>
  </div>
</BaseLayout>
