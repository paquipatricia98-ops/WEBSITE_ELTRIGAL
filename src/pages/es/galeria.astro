---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import CloudinaryImage from '../../components/ui/CloudinaryImage.astro';
import { getGallery } from '../../services/api/publicApi';

const locale = 'es';
const galleryItems = await getGallery(1, 24);
const breadcrumbs = [
  { name: 'Inicio', url: '/es/' },
  { name: 'Galería', url: '/es/galeria' },
];
---

<BaseLayout
  title="Galería de Fotos de Panes y Pasteles"
  description="Explora las fotos de nuestras creaciones artesanales: pasteles de bodas, tres leches, pan ecuatoriano y bocaditos en Orange, NJ."
  locale={locale}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <Breadcrumbs items={breadcrumbs} locale={locale} />

    <div class="mb-12 space-y-4 text-center sm:text-left">
      <span class="text-xs uppercase tracking-widest font-bold text-brand-gold-secondary">
        📸 Galería Visual
      </span>
      <h1 class="font-serif text-4xl sm:text-5xl font-extrabold text-brand-brown">
        Nuestra Galería de Fotos
      </h1>
    </div>

    <div class="pinterest-grid">
      {
        galleryItems.map((item) => (
          <div class="pinterest-item group relative rounded-2xl overflow-hidden shadow-warm border border-brand-gold/30 bg-brand-brown">
            <CloudinaryImage
              src={item.secureUrl}
              alt={item.altText[locale]}
              width={600}
              height={600}
              class="w-full h-auto object-cover group-hover:scale-110 transition-transform duration-500"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-brand-brown/90 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity p-4 flex flex-col justify-end">
              <span class="font-serif font-bold text-brand-gold text-base">
                {item.title[locale]}
              </span>
              <span class="text-xs text-brand-cream/80">
                {item.altText[locale]}
              </span>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</BaseLayout>

<style>
  .pinterest-grid {
    column-count: 1;
    column-gap: 1.5rem;
    width: 100%;
  }
  @media (min-width: 640px) {
    .pinterest-grid {
      column-count: 2;
    }
  }
  @media (min-width: 768px) {
    .pinterest-grid {
      column-count: 3;
    }
  }
  @media (min-width: 1024px) {
    .pinterest-grid {
      column-count: 4;
    }
  }
  .pinterest-item {
    break-inside: avoid;
    display: inline-block;
    width: 100%;
    margin-bottom: 1.5rem;
  }
</style>
