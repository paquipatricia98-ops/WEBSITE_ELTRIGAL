---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import HeroSection from '../../components/home/HeroSection.astro';
import FeaturedProducts from '../../components/home/FeaturedProducts.astro';
import CategoriesGrid from '../../components/home/CategoriesGrid.astro';
import EcuadorianBreadBlock from '../../components/home/EcuadorianBreadBlock.astro';
import CustomCakesTeaser from '../../components/home/CustomCakesTeaser.astro';
import HistoryTeaser from '../../components/home/HistoryTeaser.astro';
import CakeProcessSteps from '../../components/home/CakeProcessSteps.astro';
import TestimonialsSection from '../../components/home/TestimonialsSection.astro';
import FaqSection from '../../components/home/FaqSection.astro';
import LocationSection from '../../components/home/LocationSection.astro';
import GalleryTeaser from '../../components/home/GalleryTeaser.astro';
import FinalCta from '../../components/home/FinalCta.astro';
import { getBakeryJsonLd } from '../../utils/jsonld';

const locale = 'es';
const jsonLd = getBakeryJsonLd(locale);
---

<BaseLayout
  title="Pan fresco ambateño y pasteles personalizados"
  description="Panadería y Pastelería El Trigal en Orange, NJ: Sabores auténticos de Ecuador, pan de agua, allullas, empanadas de viento y pasteles de bodas y cumpleaños."
  locale={locale}
  jsonLd={jsonLd}
>
  <HeroSection locale={locale} />
  <FeaturedProducts locale={locale} />
  <CategoriesGrid locale={locale} />
  <EcuadorianBreadBlock locale={locale} />
  <CustomCakesTeaser locale={locale} />
  <HistoryTeaser locale={locale} />
  <CakeProcessSteps locale={locale} />
  <TestimonialsSection locale={locale} />
  <FaqSection locale={locale} />
  <LocationSection locale={locale} />
  <GalleryTeaser locale={locale} />
  <FinalCta locale={locale} />
</BaseLayout>
