---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import CloudinaryImage from '../../components/ui/CloudinaryImage.astro';
import DoorDashButton from '../../components/ui/DoorDashButton.astro';
import UberEatsButton from '../../components/ui/UberEatsButton.astro';
import { SITE_CONFIG } from '../../config/site';

const locale = 'es';
const breadcrumbs = [
  { name: 'Inicio', url: '/es/' },
  { name: 'Catering & Eventos', url: '/es/catering-eventos' },
];
---

<BaseLayout
  title="Servicio de Catering y Bocaditos en Orange, NJ"
  description="Bandejas de bocaditos ecuatorianos, empanaditas de viento, quesadillas y pasteles para fiestas y eventos corporativos en Orange y Essex County, NJ."
  locale={locale}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <Breadcrumbs items={breadcrumbs} locale={locale} />

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center mb-16">
      <div class="lg:col-span-6 space-y-6">
        <span class="text-xs font-bold uppercase tracking-widest text-brand-gold-secondary">
          🎉 Eventos y Fiestas Inolvidables
        </span>
        <h1 class="font-serif text-4xl sm:text-5xl font-extrabold text-brand-brown leading-tight">
          Catering con el Sabor Auténtico de Ecuador
        </h1>
        <p class="text-brand-brown/85 text-base sm:text-lg leading-relaxed">
          Preparamos bandejas de bocaditos dulces y salados para cumpleaños, bautizos, reuniones corporativas y celebraciones familiares en Orange, East Orange, West Orange y todo Essex County.
        </p>

        <div class="grid grid-cols-2 gap-4 text-xs font-bold text-brand-brown">
          <div class="bg-brand-gold/15 p-4 rounded-xl border border-brand-gold/30">
            🥟 Mini Empanadas de Viento
          </div>
          <div class="bg-brand-gold/15 p-4 rounded-xl border border-brand-gold/30">
            🥐 Allullitas y Hojaldres
          </div>
          <div class="bg-brand-gold/15 p-4 rounded-xl border border-brand-gold/30">
            🧀 Quesadillas en Porciones
          </div>
          <div class="bg-brand-gold/15 p-4 rounded-xl border border-brand-gold/30">
            🍰 Postres en Vasito
          </div>
        </div>

        <!-- Direct Action Buttons -->
        <div class="pt-4 space-y-3">
          <h3 class="font-serif font-bold text-lg text-brand-brown">Pide tu catering a domicilio:</h3>
          <div class="flex flex-wrap items-center gap-3">
            <DoorDashButton size="lg" />
            <UberEatsButton size="lg" />
          </div>
          <p class="text-xs text-brand-brown/80 pt-1">
            📞 O llámanos directamente al <a href={SITE_CONFIG.phone.tel} class="font-bold text-brand-brown underline">{SITE_CONFIG.phone.display}</a> para pedidos especiales.
          </p>
        </div>
      </div>

      <div class="lg:col-span-6">
        <div class="rounded-3xl overflow-hidden shadow-2xl border-4 border-brand-gold">
          <CloudinaryImage
            src="https://images.unsplash.com/photo-1541781774459-bb2af2f05b55?w=900&auto=format&fit=crop&q=80"
            alt="Bandejas de catering El Trigal Orange NJ"
            width={800}
            height={600}
            class="w-full h-[400px] object-cover"
          />
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
