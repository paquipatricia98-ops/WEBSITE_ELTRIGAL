---
import BaseLayout from '../../../components/layout/BaseLayout.astro';
import Breadcrumbs from '../../../components/ui/Breadcrumbs.astro';
import { useTranslations } from '../../../i18n/utils';

const locale = 'es';
const t = useTranslations(locale);
const apiUrl = import.meta.env.PUBLIC_API_BASE_URL || 'https://el-trigal-backend-nun9.onrender.com/api/v1';

const breadcrumbs = [
  { name: t('nav.home'), url: '/es/' },
  { name: t('nav.menu'), url: '/es/menu' },
];
---

<BaseLayout
  title="Menú Completo de Panadería y Pastelería"
  description="Explora todo nuestro menú de pan ecuatoriano, allullas, tres leches, empanadas de viento y bocaditos artesanales en Orange, NJ."
  locale={locale}
>
  <div class="w-full max-w-7xl xl:max-w-[1400px] 2xl:max-w-[1700px] 3xl:max-w-[92vw] mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-8" data-locale={locale} data-api={apiUrl} id="menu-container">
    <Breadcrumbs items={breadcrumbs} locale={locale} />

    <!-- PAGE HEADER -->
    <div class="space-y-4 text-center sm:text-left">
      <h1 class="font-serif text-2xl sm:text-3xl lg:text-4xl font-extrabold text-brand-brown">
        {t('menu.title')}
      </h1>
      <p class="text-brand-brown/85 text-base sm:text-lg max-w-3xl leading-relaxed">
        {t('menu.subtitle')}
      </p>
    </div>

    <!-- SEARCH & CATEGORY FILTER CONTROL BAR -->
    <div class="w-full bg-brand-cream p-4 sm:p-6 rounded-3xl border-2 border-brand-gold/40 shadow-xl space-y-5">
      
      <!-- Real-Time Search Bar -->
      <div class="relative w-full max-w-xl mx-auto">
        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-brand-gold-secondary">
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
            <path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
          </svg>
        </div>
        <input
          type="text"
          id="product-search-input"
          class="w-full pl-12 pr-10 py-3.5 rounded-full bg-brand-cream-dark/60 border border-brand-gold/40 text-brand-brown font-semibold placeholder:text-brand-brown/50 focus:outline-none focus:ring-2 focus:ring-brand-gold focus:border-brand-gold transition-all text-sm sm:text-base shadow-inner"
          placeholder="Buscar pan, pastel, empanada, bocaditos..."
        />
        <button
          type="button"
          id="clear-search-btn"
          class="hidden absolute inset-y-0 right-0 pr-4 flex items-center text-brand-brown/60 hover:text-brand-brown"
          aria-label="Limpiar búsqueda"
        >
          ✕
        </button>
      </div>

      <!-- Category Filter Pills (Dynamically populated) -->
      <div class="flex flex-wrap items-center justify-center gap-2 pt-2 border-t border-brand-gold/20" id="category-pills-container">
        <!-- Pills will be injected here -->
      </div>
    </div>

    <!-- PRODUCT COUNT & FILTER STATUS -->
    <div class="flex items-center justify-between text-xs sm:text-sm font-bold text-brand-brown/80 px-1">
      <span id="product-count-label">Cargando catálogo...</span>
    </div>

    <!-- PRODUCT CARDS GRID -->
    <div class="flex flex-wrap justify-center gap-6 xl:gap-8 min-h-[400px]" id="products-grid">
      <div class="w-full text-center text-brand-brown/50 animate-pulse py-20">
        Cargando todos los productos, por favor espera...
      </div>
    </div>

    <!-- NO RESULTS EMPTY STATE -->
    <div id="no-results-state" class="hidden text-center py-16 bg-brand-cream rounded-3xl border-2 border-dashed border-brand-gold/40 p-8 space-y-4">
      <div class="text-4xl">🔍</div>
      <h3 class="font-serif text-xl font-bold text-brand-brown">No encontramos productos con esa búsqueda</h3>
      <p class="text-xs sm:text-sm text-brand-brown/70 max-w-md mx-auto">
        Prueba buscando otro término o haz clic en "Todas las Categorías" para ver el catálogo completo.
      </p>
      <button
        type="button"
        id="reset-filter-btn"
        class="px-5 py-2.5 rounded-xl bg-brand-gold text-brand-brown font-extrabold text-xs shadow-md hover:bg-brand-gold-secondary transition-all"
      >
        Ver Todos los Productos
      </button>
    </div>
  </div>

  <script>
    function formatPriceCents(cents: any, locale: any) {
      return new Intl.NumberFormat(locale === 'es' ? 'es-US' : 'en-US', {
        style: 'currency',
        currency: 'USD',
      }).format(cents / 100);
    }

    async function loadCatalog() {
      const container = document.getElementById('menu-container');
      if (!container) return;

      const locale = container.dataset.locale as string;
      const isLocalhost = window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1';
      const apiUrl = isLocalhost ? '/api/v1' : (container.dataset.api || '/api/v1');

      const searchInput = document.getElementById('product-search-input') as HTMLInputElement | null;
      const clearBtn = document.getElementById('clear-search-btn');
      const resetBtn = document.getElementById('reset-filter-btn');
      const pillsContainer = document.getElementById('category-pills-container');
      const productsGrid = document.getElementById('products-grid');
      const countLabel = document.getElementById('product-count-label');
      const noResults = document.getElementById('no-results-state');

      let activeCategory = 'todas';
      let allItems: any[] = [];

      const getStr = (val: any, lang: string) => {
        if (!val) return '';
        if (typeof val === 'string') return val;
        if (typeof val === 'object') return val[lang] || val.es || val.en || '';
        return String(val);
      };

      try {
        const response = await fetch(`${apiUrl}/public/products?limit=100`);
        if (!response.ok) throw new Error('API Error');
        const data = await response.json();
        const products = data.data || [];

        // Generate Categories
        const uniqueCatIds = Array.from(new Set(products.map((p: any) => p.primaryCategory?.id || p.primaryCategory?._id))).filter(Boolean);
        const dynamicCategories = [
          { id: 'todas', label: locale === 'es' ? 'Todas las Categorías' : 'All Categories', icon: '✨' },
          ...uniqueCatIds.map((catId: any) => {
            const prod = products.find((p: any) => p.primaryCategory?.id === catId || p.primaryCategory?._id === catId);
            const slugStr = getStr(prod?.primaryCategory?.slug, locale) || String(catId);
            const catLabel = getStr(prod?.primaryCategory?.name, locale) || (locale === 'es' ? 'Categoría' : 'Category');
            const icon = (slugStr.includes('pastel') || slugStr.includes('cake') || slugStr.includes('dulce') || slugStr.includes('sweet')) ? '🍰' : '🥖';
            return {
              id: slugStr,
              label: catLabel,
              icon: icon
            };
          })
        ];

        // Render Category Pills
        if (pillsContainer) {
          pillsContainer.innerHTML = dynamicCategories.map(c => `
            <button
              type="button"
            data-category="${c.id}"
            class="category-pill px-4 py-2 rounded-xl text-xs sm:text-sm font-extrabold transition-all border shadow-sm flex items-center space-x-1.5 cursor-pointer ${
              c.id === 'todas'
                ? 'bg-brand-brown text-brand-gold border-brand-gold shadow-md active-pill'
                : 'bg-brand-cream-dark text-brand-brown border-brand-gold/30 hover:bg-brand-gold/20'
            }"
          >
            <span>${c.icon}</span>
            <span>${c.label}</span>
          </button>
        `).join('');
        }

        // Generate Products HTML
        const productsHtml = products.map((product: any) => {
          const primaryImage = product.media?.find((m: any) => m.isPrimary) || product.media?.[0];
          const imageUrl = primaryImage ? (primaryImage.secureUrl || primaryImage.url || '') : (product.productoImage || '');
          const prodName = getStr(product.name || product.productoName, locale);
          const altText = primaryImage ? (getStr(primaryImage.altText || primaryImage.alt, locale) || prodName) : prodName;
          
          const prodSlug = getStr(product.slug || product.productoSlug, locale);
          const productUrl = locale === 'es'
            ? `/es/productos/${prodSlug}`
            : `/en/products/${prodSlug}`;

          const formattedPrice = product.priceLabel?.[locale]
            ? product.priceLabel[locale]
            : (product.basePriceCents
              ? formatPriceCents(product.basePriceCents, locale)
              : (product.productoPrice ? `$${product.productoPrice.toFixed(2)}` : null));

          const catName = getStr(product.primaryCategory?.name, locale);
          const catKey = getStr(product.primaryCategory?.slug, locale) || 'todas';
          const desc = getStr(product.shortDescription || product.description || product.productoDescription, locale);
          const tags = Array.isArray(product.tags) ? product.tags.join(' ') : '';
          const searchText = `${prodName} ${desc} ${tags}`.toLowerCase();

          return `
            <div class="product-item-wrapper w-full sm:w-[280px] md:w-[300px] xl:w-[320px] flex-shrink-0" data-category="${catKey}" data-search="${searchText}">
              <article class="bg-brand-cream border border-brand-gold/30 rounded-2xl overflow-hidden shadow-warm hover:shadow-warm-hover transition-all duration-300 flex flex-col group h-full">
                <a href="${productUrl}" class="relative block overflow-hidden aspect-[4/3] bg-brand-cream-dark">
                  ${imageUrl ? `
                    <img src="${imageUrl}" alt="${altText}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
                  ` : `
                    <div class="w-full h-full flex items-center justify-center text-4xl text-brand-gold-secondary">🍞</div>
                  `}
                </a>
                <div class="p-5 flex flex-col flex-grow space-y-2">
                  <div class="flex flex-wrap items-center justify-between gap-1">
                    <span class="text-xs font-semibold text-brand-gold-secondary uppercase tracking-wider">${catName}</span>
                    <span class="flex items-center gap-1 bg-brand-brown text-brand-gold text-[10px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full">🚚 Delivery</span>
                  </div>
                  <h3 class="font-serif font-bold text-xl text-brand-brown group-hover:text-brand-brown-dark transition-colors line-clamp-1">
                    <a href="${productUrl}" class="focus:outline-none focus:underline">${prodName}</a>
                  </h3>
                  <p class="text-xs sm:text-sm text-brand-brown/75 line-clamp-2 leading-relaxed flex-grow">${desc}</p>
                  <div class="pt-2 flex items-center justify-between border-t border-brand-gold/20">
                    ${formattedPrice ? `
                      <span class="font-serif font-extrabold text-xl text-brand-brown">${formattedPrice}</span>
                    ` : `
                      <span class="text-xs text-brand-brown/50 italic">${locale === 'es' ? 'Consultar precio' : 'Ask for price'}</span>
                    `}
                    <a href="${productUrl}" class="text-xs font-bold text-brand-brown/60 hover:text-brand-brown underline-offset-2 hover:underline transition-colors">
                      ${locale === 'es' ? 'Ver más →' : 'View →'}
                    </a>
                  </div>
                </div>
              </article>
            </div>
          `;
        });

        if (productsGrid) {
          productsGrid.innerHTML = productsHtml.join('');
        }
        
        // Re-attach elements and events
        allItems = Array.from(document.querySelectorAll('.product-item-wrapper'));
        const pills = document.querySelectorAll('.category-pill');

        const filterProducts = () => {
          const query = (searchInput?.value || '').trim().toLowerCase();
          let visibleCount = 0;

          if (clearBtn) {
            clearBtn.classList.toggle('hidden', query.length === 0);
          }

          allItems.forEach((item) => {
            const itemCat = item.getAttribute('data-category') || '';
            const itemSearchText = item.getAttribute('data-search') || '';

            const matchesCat = activeCategory === 'todas' || itemCat === activeCategory;
            const matchesQuery = query === '' || itemSearchText.includes(query);

            if (matchesCat && matchesQuery) {
              item.classList.remove('hidden');
              visibleCount++;
            } else {
              item.classList.add('hidden');
            }
          });

          if (countLabel) {
            countLabel.textContent = `Mostrando ${visibleCount} de ${allItems.length} productos`;
          }

          if (noResults) {
            noResults.classList.toggle('hidden', visibleCount > 0);
          }
        };

        // Pill Events
        pills.forEach((pill) => {
          pill.addEventListener('click', () => {
            const cat = pill.getAttribute('data-category') || 'todas';
            activeCategory = cat;

            pills.forEach((p) => {
              if (p.getAttribute('data-category') === cat) {
                p.className = 'category-pill px-4 py-2 rounded-xl text-xs sm:text-sm font-extrabold transition-all border shadow-md bg-brand-brown text-brand-gold border-brand-gold cursor-pointer active-pill';
              } else {
                p.className = 'category-pill px-4 py-2 rounded-xl text-xs sm:text-sm font-extrabold transition-all border shadow-sm bg-brand-cream-dark text-brand-brown border-brand-gold/30 hover:bg-brand-gold/20 cursor-pointer';
              }
            });

            filterProducts();
          });
        });

        // Search Events
        if (searchInput) searchInput.addEventListener('input', filterProducts);
        if (clearBtn) {
          clearBtn.addEventListener('click', () => {
            if (searchInput) {
              searchInput.value = '';
              filterProducts();
            }
          });
        }
        if (resetBtn) {
          resetBtn.addEventListener('click', () => {
            if (searchInput) searchInput.value = '';
            activeCategory = 'todas';
            pills.forEach((p) => {
              const cat = p.getAttribute('data-category');
              if (cat === 'todas') {
                p.className = 'category-pill px-4 py-2 rounded-xl text-xs sm:text-sm font-extrabold transition-all border shadow-md bg-brand-brown text-brand-gold border-brand-gold cursor-pointer active-pill';
              } else {
                p.className = 'category-pill px-4 py-2 rounded-xl text-xs sm:text-sm font-extrabold transition-all border shadow-sm bg-brand-cream-dark text-brand-brown border-brand-gold/30 hover:bg-brand-gold/20 cursor-pointer';
              }
            });
            filterProducts();
          });
        }

        // Apply initial filters if any
        const urlParams = new URLSearchParams(window.location.search);
        const categoryQuery = urlParams.get('category');
        const searchQuery = urlParams.get('search');

        if (categoryQuery) {
          activeCategory = categoryQuery;
          pills.forEach((p) => {
            const cat = p.getAttribute('data-category');
            if (cat === categoryQuery) {
              p.className = 'category-pill px-4 py-2 rounded-xl text-xs sm:text-sm font-extrabold transition-all border shadow-md bg-brand-brown text-brand-gold border-brand-gold cursor-pointer active-pill';
            } else {
              p.className = 'category-pill px-4 py-2 rounded-xl text-xs sm:text-sm font-extrabold transition-all border shadow-sm bg-brand-cream-dark text-brand-brown border-brand-gold/30 hover:bg-brand-gold/20 cursor-pointer';
            }
          });
        }
        if (searchQuery && searchInput) {
          searchInput.value = searchQuery;
        }

        filterProducts();

      } catch (error) {
        console.error('Error fetching products:', error);
        if (countLabel) countLabel.textContent = 'Error al cargar los productos.';
      }
    }

    loadCatalog();
    document.addEventListener('DOMContentLoaded', loadCatalog);
    document.addEventListener('astro:page-load', loadCatalog);
  </script>
</BaseLayout>
