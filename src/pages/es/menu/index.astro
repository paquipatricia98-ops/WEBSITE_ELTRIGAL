---
import BaseLayout from '../../../components/layout/BaseLayout.astro';
import Breadcrumbs from '../../../components/ui/Breadcrumbs.astro';
import ProductCard from '../../../components/products/ProductCard.astro';
import { getCategories, getProducts } from '../../../services/api/publicApi';
import { useTranslations } from '../../../i18n/utils';

const locale = 'es';
const t = useTranslations(locale);

const categories = await getCategories(locale, 'local');
const { products } = await getProducts({
  locale,
  limit: 100,
  type: 'local',
});

// Group products by category
const categoriesWithProducts = categories.map(cat => {
  const catProducts = products.filter(p => 
    p.primaryCategory?.id === cat.id || 
    p.primaryCategory?.slug?.es === cat.slug?.es ||
    p.primaryCategory?.slug?.en === cat.slug?.en
  );
  return {
    ...cat,
    icon: cat.slug[locale]?.includes('pastel') || cat.slug[locale]?.includes('dulce') ? '🍰' : '🥖',
    products: catProducts
  };
}).filter(cat => cat.products.length > 0);

const breadcrumbs = [
  { name: t('nav.home'), url: '/es/' },
  { name: t('nav.menu'), url: '/es/menu' },
];
---

<BaseLayout
  title="Menú Completo de Panadería y Pastelería"
  description="Explora todo nuestro menú de pan ecuatoriano, allullas, tres leches, empanadas de viento y bocaditos artesanales en Orange, NJ."
  locale={locale}
>
  <div class="w-full max-w-7xl xl:max-w-[1400px] 2xl:max-w-[1700px] 3xl:max-w-[92vw] mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-8">
    <Breadcrumbs items={breadcrumbs} locale={locale} />

    <!-- PAGE HEADER -->
    <div class="space-y-4 text-center sm:text-left">
      <h1 class="font-serif text-2xl sm:text-3xl lg:text-4xl font-extrabold text-brand-brown">
        {t('menu.title')}
      </h1>
      <p class="text-brand-brown/85 text-base sm:text-lg max-w-3xl leading-relaxed">
        {t('menu.subtitle')}
      </p>
    </div>

    <!-- SEARCH BAR -->
    <div class="w-full bg-brand-cream p-4 rounded-3xl border-2 border-brand-gold/40 shadow-xl">
      <div class="relative w-full max-w-xl mx-auto">
        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-brand-gold-secondary">
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
            <path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
          </svg>
        </div>
        <input
          type="text"
          id="product-search-input"
          class="w-full pl-12 pr-10 py-3.5 rounded-full bg-brand-cream-dark/60 border border-brand-gold/40 text-brand-brown font-semibold placeholder:text-brand-brown/50 focus:outline-none focus:ring-2 focus:ring-brand-gold focus:border-brand-gold transition-all text-sm sm:text-base shadow-inner"
          placeholder="Buscar pan, pastel, empanada, bocaditos..."
        />
        <button
          type="button"
          id="clear-search-btn"
          class="hidden absolute inset-y-0 right-0 pr-4 flex items-center text-brand-brown/60 hover:text-brand-brown"
          aria-label="Limpiar búsqueda"
        >
          ✕
        </button>
      </div>
    </div>

    <!-- MENU GROUPED BY CATEGORY -->
    <div class="space-y-12" id="menu-categories-container">
      {categoriesWithProducts.map((cat) => (
        <section class="category-section space-y-6" data-category-id={cat.id}>
          <h2 class="font-serif text-xl sm:text-2xl font-extrabold text-brand-brown border-b border-brand-gold/30 pb-3 flex items-center gap-2">
            <span>{cat.icon}</span>
            <span>{cat.name[locale]}</span>
          </h2>
          <div class="flex flex-wrap justify-center sm:justify-start gap-6 xl:gap-8 products-grid">
            {cat.products.map((p) => (
              <div
                class="product-item-wrapper w-full sm:w-[280px] md:w-[300px] xl:w-[320px] flex-shrink-0"
                data-search={`${p.name[locale]} ${p.shortDescription?.[locale] || ''} ${p.tags.join(' ')}`.toLowerCase()}
              >
                <ProductCard product={p} locale={locale} />
              </div>
            ))}
          </div>
        </section>
      ))}
    </div>

    <!-- NO RESULTS EMPTY STATE -->
    <div id="no-results-state" class="hidden text-center py-16 bg-brand-cream rounded-3xl border-2 border-dashed border-brand-gold/40 p-8 space-y-4">
      <div class="text-4xl">🔍</div>
      <h3 class="font-serif text-xl font-bold text-brand-brown">No encontramos productos con esa búsqueda</h3>
      <p class="text-xs sm:text-sm text-brand-brown/70 max-w-md mx-auto">
        Prueba buscando otro término para ver los productos de nuestro menú.
      </p>
      <button
        type="button"
        id="reset-filter-btn"
        class="px-5 py-2.5 rounded-xl bg-brand-gold text-brand-brown font-extrabold text-xs shadow-md hover:bg-brand-gold-secondary transition-all"
      >
        Ver Todos los Productos
      </button>
    </div>
  </div>

  <!-- Real-Time Client-Side Filtering Script -->
  <script>
    const searchInput = document.getElementById('product-search-input') as HTMLInputElement | null;
    const clearBtn = document.getElementById('clear-search-btn');
    const resetBtn = document.getElementById('reset-filter-btn');
    const sections = document.querySelectorAll<HTMLElement>('.category-section');
    const noResults = document.getElementById('no-results-state');

    const filterProducts = () => {
      const query = (searchInput?.value || '').trim().toLowerCase();
      let totalVisible = 0;

      if (clearBtn) {
        clearBtn.classList.toggle('hidden', query.length === 0);
      }

      sections.forEach((section) => {
        const items = section.querySelectorAll<HTMLElement>('.product-item-wrapper');
        let visibleInSection = 0;

        items.forEach((item) => {
          const itemSearchText = item.getAttribute('data-search') || '';
          const matchesQuery = query === '' || itemSearchText.includes(query);

          if (matchesQuery) {
            item.classList.remove('hidden');
            visibleInSection++;
            totalVisible++;
          } else {
            item.classList.add('hidden');
          }
        });

        // Hide section completely if it contains no visible products
        if (visibleInSection > 0) {
          section.classList.remove('hidden');
        } else {
          section.classList.add('hidden');
        }
      });

      if (noResults) {
        noResults.classList.toggle('hidden', totalVisible > 0);
      }
    };

    // Search Input Event
    if (searchInput) {
      searchInput.addEventListener('input', filterProducts);
    }

    // Clear Search Event
    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        if (searchInput) {
          searchInput.value = '';
          filterProducts();
        }
      });
    }

    // Reset Filters Event
    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        if (searchInput) {
          searchInput.value = '';
          filterProducts();
        }
      });
    }
  </script>
</BaseLayout>
