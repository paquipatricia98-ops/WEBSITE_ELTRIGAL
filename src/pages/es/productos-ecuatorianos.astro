---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import ProductCard from '../../components/products/ProductCard.astro';
import { getImportedProducts } from '../../services/api/publicApi';

const locale = 'es';
const { products } = await getImportedProducts(locale, 100);

// Map categories from the products returned by the API
const uniqueCatIds = Array.from(new Set(products.map(p => p.primaryCategory?.id))).filter(Boolean);

const dynamicCategories = [
  { id: 'todas', label: 'Todas las Categorías', icon: '✨' },
  ...uniqueCatIds.map(catId => {
    const prod = products.find(p => p.primaryCategory?.id === catId);
    return {
      id: prod?.primaryCategory?.slug?.[locale] || catId,
      label: prod?.primaryCategory?.name?.[locale] || 'Categoría',
      icon: '🛒'
    };
  })
];

const categorizedProducts = products.map((p) => ({
  ...p,
  catKey: p.primaryCategory?.slug?.[locale] || 'todas',
}));

const breadcrumbs = [
  { name: 'Inicio', url: '/es/' },
  { name: 'Productos 🇪🇨', url: '/es/productos-ecuatorianos' },
];
---

<BaseLayout
  title="Productos Auténticos de Ecuador en Orange, NJ | El Trigal"
  description="Encuentra productos auténticos de Ecuador en Orange, NJ: lácteos, yogur, queso fresco, manjar blanco, chocolates de Manabí, café de Loja y chifles."
  locale={locale}
>
  <div class="w-full max-w-7xl xl:max-w-[1400px] 2xl:max-w-[1700px] 3xl:max-w-[92vw] mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-8">
    <Breadcrumbs items={breadcrumbs} locale={locale} />

    <!-- PAGE HEADER -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div class="space-y-4 text-center md:text-left">
        <span class="text-xs uppercase tracking-widest font-bold text-brand-gold-secondary">
          🇪🇨 Lo Mejor de Nuestra Tierra
        </span>
        <h1 class="font-serif text-2xl sm:text-3xl lg:text-4xl font-extrabold text-brand-brown">
          Productos Importados 🇪🇨
        </h1>
        <p class="text-brand-brown/85 text-base sm:text-lg max-w-3xl leading-relaxed">
          Encuentra tus favoritos de Ecuador: productos lácteos frescos (yogur, queso manaba), dulces tradicionales (manjar, cocadas, chocolates), panadería ambateña, café gourmet y snacks.
        </p>
      </div>
      <div class="flex justify-center md:justify-end md:self-end pb-1.5">
        <button 
          id="share-catalog-btn"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full border border-brand-gold bg-[#fdfdfb] text-brand-brown font-bold text-sm shadow-sm hover:bg-brand-gold/15 transition-all cursor-pointer whitespace-nowrap"
        >
          <svg class="w-4 h-4 fill-current text-brand-gold-secondary" viewBox="0 0 24 24">
            <path d="M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81 1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3c0 .24.04.47.09.7L8.04 9.81C7.5 9.31 6.79 9 6 9c-1.66 0-3 1.34-3 3s1.34 3 3 3c.79 0 1.5-.31 2.04-.81l7.12 4.16c-.05.21-.08.43-.08.65 0 1.61 1.31 2.92 2.92 2.92s2.92-1.31 2.92-2.92c0-1.61-1.31-2.92-2.92-2.92zM18 4c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zM6 13c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1zm12 7.02c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1z"/>
          </svg>
          <span id="share-btn-text">Compartir Catálogo</span>
        </button>
      </div>
    </div>

    <!-- SEARCH & CATEGORY FILTER CONTROL BAR -->
    <div class="w-full bg-[#fdfdfb]/90 p-6 md:p-8 rounded-[24px] border border-brand-gold/40 shadow-sm space-y-6">
      
      <!-- Real-Time Search Bar (Centered with oval pill borders) -->
      <div class="relative w-full max-w-xl mx-auto">
        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-brand-gold-secondary">
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
            <path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
          </svg>
        </div>
        <input
          type="text"
          id="product-search-input"
          class="w-full pl-12 pr-10 py-3 rounded-full bg-[#FAF7F2] border border-brand-gold/35 text-brand-brown font-semibold placeholder:text-brand-brown/40 focus:outline-none focus:ring-2 focus:ring-brand-gold/50 focus:border-brand-gold/50 transition-all text-sm shadow-inner"
          placeholder="Buscar yogur, queso, manjar, chocolates, café, allullas, chifles..."
        />
        <button
          type="button"
          id="clear-search-btn"
          class="hidden absolute inset-y-0 right-0 pr-4 flex items-center text-brand-brown/60 hover:text-brand-brown"
          aria-label="Limpiar búsqueda"
        >
          ✕
        </button>
      </div>

      <!-- Category Filter Pills (Centered) -->
      <div class="flex flex-wrap items-center justify-center gap-2.5 pt-4 border-t border-brand-gold/15" id="category-pills-container">
        {dynamicCategories.map((c) => (
          <button
            type="button"
            data-category={c.id}
            class={`category-pill px-4.5 py-2.5 rounded-xl text-xs sm:text-sm font-bold transition-all border shadow-xs flex items-center space-x-1.5 cursor-pointer ${
              c.id === 'todas'
                ? 'bg-brand-brown text-brand-gold border-brand-brown active-pill'
                : 'bg-[#FAF7F2] text-brand-brown border-brand-gold/25 hover:bg-brand-gold/10'
            }`}
          >
            <span>{c.icon}</span>
            <span>{c.label}</span>
          </button>
        ))}
      </div>
    </div>

    <!-- PRODUCT COUNT & FILTER STATUS -->
    <div class="flex items-center justify-between text-xs sm:text-sm font-bold text-brand-brown/80 px-1">
      <span id="product-count-label">Mostrando {categorizedProducts.length} productos ecuatorianos</span>
    </div>

    <!-- PRODUCT CARDS GRID (Centered) -->
    <div class="flex flex-wrap justify-center gap-6 xl:gap-8" id="products-grid">
      {categorizedProducts.map((p) => (
        <div
          class="product-item-wrapper w-full sm:w-[280px] md:w-[300px] xl:w-[320px] flex-shrink-0"
          data-category={p.catKey}
          data-search={`${p.name[locale]} ${p.shortDescription?.[locale] || ''} ${p.tags.join(' ')}`.toLowerCase()}
        >
          <ProductCard product={p} locale={locale} />
        </div>
      ))}
    </div>

    <!-- NO RESULTS EMPTY STATE -->
    <div id="no-results-state" class="hidden text-center py-16 bg-brand-cream rounded-3xl border-2 border-dashed border-brand-gold/40 p-8 space-y-4">
      <div class="text-4xl">🔍</div>
      <h3 class="font-serif text-xl font-bold text-brand-brown">No encontramos productos con esa búsqueda</h3>
      <p class="text-xs sm:text-sm text-brand-brown/70 max-w-md mx-auto">
        Prueba buscando otro término o haz clic en "Todas las Categorías" para ver el catálogo completo.
      </p>
      <button
        type="button"
        id="reset-filter-btn"
        class="px-5 py-2.5 rounded-xl bg-brand-gold text-brand-brown font-extrabold text-xs shadow-md hover:bg-brand-gold-secondary transition-all"
      >
        Ver Todos los Productos 🇪🇨
      </button>
    </div>
  </div>

  <!-- Real-Time Client-Side Filtering Script -->
  <script>
    const searchInput = document.getElementById('product-search-input') as HTMLInputElement | null;
    const clearBtn = document.getElementById('clear-search-btn');
    const resetBtn = document.getElementById('reset-filter-btn');
    const pills = document.querySelectorAll<HTMLButtonElement>('.category-pill');
    const items = document.querySelectorAll<HTMLElement>('.product-item-wrapper');
    const countLabel = document.getElementById('product-count-label');
    const noResults = document.getElementById('no-results-state');

    let activeCategory = 'todas';

    const filterProducts = () => {
      const query = (searchInput?.value || '').trim().toLowerCase();
      let visibleCount = 0;

      if (clearBtn) {
        clearBtn.classList.toggle('hidden', query.length === 0);
      }

      items.forEach((item) => {
        const itemCat = item.getAttribute('data-category') || '';
        const itemSearchText = item.getAttribute('data-search') || '';

        const matchesCat = activeCategory === 'todas' || itemCat === activeCategory;
        const matchesQuery = query === '' || itemSearchText.includes(query);

        if (matchesCat && matchesQuery) {
          item.classList.remove('hidden');
          visibleCount++;
        } else {
          item.classList.add('hidden');
        }
      });

      if (countLabel) {
        countLabel.textContent = `Mostrando ${visibleCount} de ${items.length} productos ecuatorianos`;
      }

      if (noResults) {
        noResults.classList.toggle('hidden', visibleCount > 0);
      }
    };

    // Category Pill Click Handler
    pills.forEach((pill) => {
      pill.addEventListener('click', () => {
        const cat = pill.getAttribute('data-category') || 'todas';
        activeCategory = cat;

        pills.forEach((p) => {
          if (p.getAttribute('data-category') === cat) {
            p.className = 'category-pill px-4.5 py-2.5 rounded-xl text-xs sm:text-sm font-bold transition-all border shadow-xs flex items-center space-x-1.5 cursor-pointer bg-brand-brown text-brand-gold border-brand-brown active-pill';
          } else {
            p.className = 'category-pill px-4.5 py-2.5 rounded-xl text-xs sm:text-sm font-bold transition-all border shadow-xs flex items-center space-x-1.5 cursor-pointer bg-[#FAF7F2] text-brand-brown border-brand-gold/25 hover:bg-brand-gold/10';
          }
        });

        filterProducts();
      });
    });

    // Search Input Event
    if (searchInput) {
      searchInput.addEventListener('input', filterProducts);
    }

    // Clear Search Event
    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        if (searchInput) {
          searchInput.value = '';
          filterProducts();
        }
      });
    }

    // Reset Filters Event
    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        activeCategory = 'todas';
        pills.forEach((p) => {
          const cat = p.getAttribute('data-category');
          if (cat === 'todas') {
            p.className = 'category-pill px-4.5 py-2.5 rounded-xl text-xs sm:text-sm font-bold transition-all border shadow-xs flex items-center space-x-1.5 cursor-pointer bg-brand-brown text-brand-gold border-brand-brown active-pill';
          } else {
            p.className = 'category-pill px-4.5 py-2.5 rounded-xl text-xs sm:text-sm font-bold transition-all border shadow-xs flex items-center space-x-1.5 cursor-pointer bg-[#FAF7F2] text-brand-brown border-brand-gold/25 hover:bg-brand-gold/10';
          }
        });
        filterProducts();
      });
    }

    // Share Button Event
    const shareBtn = document.getElementById('share-catalog-btn');
    const shareBtnText = document.getElementById('share-btn-text');

    if (shareBtn && shareBtnText) {
      shareBtn.addEventListener('click', async () => {
        const shareData = {
          title: document.title || 'Catálogo - El Trigal',
          text: 'Echa un vistazo a las delicias del catálogo de El Trigal.',
          url: window.location.href
        };

        try {
          if (navigator.share) {
            await navigator.share(shareData);
          } else {
            await navigator.clipboard.writeText(window.location.href);
            shareBtnText.textContent = '¡Enlace Copiado! 📋';
            setTimeout(() => {
              shareBtnText.textContent = 'Compartir Catálogo';
            }, 2500);
          }
        } catch (err) {
          try {
            await navigator.clipboard.writeText(window.location.href);
            shareBtnText.textContent = '¡Enlace Copiado! 📋';
            setTimeout(() => {
              shareBtnText.textContent = 'Compartir Catálogo';
            }, 2500);
          } catch (e) {}
        }
      });
    }
  </script>
</BaseLayout>
