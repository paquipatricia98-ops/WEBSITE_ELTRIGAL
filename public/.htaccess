ErrorDocument 404 /404.html
ErrorDocument 500 /500.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Route missing product routes in Spanish
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^es/productos/(.+)$ /404.html [L,QSA]

  # Route missing product routes in English
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^en/products/(.+)$ /404.html [L,QSA]

  # Route missing category routes in Spanish
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^es/menu/(.+)$ /404.html [L,QSA]

  # Route missing category routes in English
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^en/menu/(.+)$ /404.html [L,QSA]
</IfModule>
